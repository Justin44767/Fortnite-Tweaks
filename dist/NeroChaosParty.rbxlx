  <Item class="ServerScriptService" referent="RBX1374">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="ModuleScript" referent="RBX1375">
      <Properties>
        <string name="Name">ChaosEvents</string>
        <ProtectedString name="Source">local Run=game:GetService("RunService")
local Lighting=game:GetService("Lighting")
local RS=game:GetService("ReplicatedStorage")
local Scope=require(RS.Shared.Scope)
local Catalog=require(RS.Shared.Catalog)
local Ragdoll=require(script.Parent.Ragdoll)
local Events={}
local function every(scope,interval,callback)
    local elapsed=interval
    scope:Add(Run.Heartbeat:Connect(function(dt)
        elapsed+=dt if elapsed&gt;=interval then elapsed=0 callback(dt) end
    end))
end
Events.Every=every
local function model(ctx,scope,name,pos,scale)
    local m=scope:Add(RS.Assets[name]:Clone()) m.Parent=ctx.Map m:ScaleTo(scale or 1) m:PivotTo(CFrame.new(pos))
    for _,p in m:GetDescendants() do if p:IsA("BasePart") then p.CanCollide=false p.CanTouch=false end end
    return m
end
function Events.Drop(ctx,scope,name,target,radius,power)
    if not scope.Alive then return end
    local warning=scope:Add(ctx:Part("Warning",Vector3.new(target.X,target.Y-3,target.Z),Vector3.new(radius*2,.15,radius*2),Color3.fromRGB(255,75,100)))
    warning.CanCollide=false warning.Material=Enum.Material.Neon warning.Transparency=.4
    scope:Delay(.8,function()
        local object=model(ctx,scope,name,target+Vector3.new(0,55,0),3)
        local t=0 local conn
        conn=Run.Heartbeat:Connect(function(dt)
            if not scope.Alive then return end
            t+=dt object:PivotTo(CFrame.new(target+Vector3.new(0,55*(1-t/.7),0))*CFrame.Angles(t*3,t,0))
            if t&gt;=.7 then
                conn:Disconnect() warning:Destroy() object:Destroy() ctx:Effect("Explosion",target)
                ctx:Each(function(p,_,root)
                    local delta=root.Position-target
                    if delta.Magnitude&lt;radius+3 then
                        local direction=if delta.Magnitude&gt;.1 then delta.Unit else Vector3.xAxis
                        Ragdoll.Start(p.Character,1.3,direction*power+Vector3.new(0,25,0))
                    end
                end)
            end
        end)
        scope:Add(conn)
    end)
end
function Events.Rain(ctx,scope,name,interval,power)
    every(scope,interval,function()
        local choices={} ctx:Each(function(_,_,root) table.insert(choices,root.Position) end)
        if #choices&gt;0 then
            local target=choices[ctx.Random:NextInteger(1,#choices)]+Vector3.new(ctx.Random:NextNumber(-6,6),0,ctx.Random:NextNumber(-6,6))
            Events.Drop(ctx,scope,name,target,6,power or 35)
        end
    end)
end
function Events.Chaser(ctx,scope,name,start,speed)
    local npc=model(ctx,scope,name,start,4)
    local pos=start local waypoints={} local index=1 local nextPath=0 local computing=false
    every(scope,.1,function()
        local target,distance=nil,math.huge
        ctx:Each(function(_,_,root)
            local d=(root.Position-pos).Magnitude if d&lt;distance then distance=d target=root.Position end
        end)
        if not target then return end
        if os.clock()&gt;nextPath and not computing then
            computing=true nextPath=os.clock()+1.5
            local goal=target
            task.spawn(function()
                local path=game:GetService("PathfindingService"):CreatePath({AgentRadius=3,AgentHeight=6,AgentCanJump=false,WaypointSpacing=5})
                local ok=pcall(function() path:ComputeAsync(pos,goal) end)
                if scope.Alive and ok and path.Status==Enum.PathStatus.Success then waypoints=path:GetWaypoints() index=2 end
                computing=false path:Destroy()
            end)
        end
        local goal=if waypoints[index] then waypoints[index].Position else target
        local delta=Vector3.new(goal.X-pos.X,0,goal.Z-pos.Z)
        if delta.Magnitude&lt;3 and waypoints[index] then index+=1 end
        if delta.Magnitude&gt;.1 then
            local step=delta.Unit*math.min(speed*.1,delta.Magnitude)
            local params=RaycastParams.new() params.FilterType=Enum.RaycastFilterType.Exclude params.FilterDescendantsInstances={npc}
            local obstruction=workspace:Raycast(pos,step+delta.Unit*2,params)
            if not obstruction or obstruction.Instance:IsDescendantOf(npc) or not obstruction.Instance.CanCollide then pos+=step end
            npc:PivotTo(CFrame.lookAt(pos+Vector3.new(0,math.sin(os.clock()*7)*.3,0),pos+delta.Unit))
        end
        ctx:Each(function(p,_,root) if (root.Position-pos).Magnitude&lt;6 then ctx:Effect("Duck",root.Position) ctx:Eliminate(p) end end)
    end)
    return npc
end
local handlers={}
handlers.GiantHead=function(ctx,s)
    ctx:Each(function(p)
        local hum=p.Character:FindFirstChildOfClass("Humanoid") local scale=hum:FindFirstChild("HeadScale")
        if scale then s:Property(scale,"Value",scale.Value*2)
        else local head=p.Character:FindFirstChild("Head") if head then s:Property(head,"Size",head.Size*1.7) end end
    end)
end
handlers.Tiny=function(ctx,s)
    ctx:Each(function(p)
        local c=p.Character local old=c:GetScale() c:ScaleTo(old*.55)
        s:Add(function() if c.Parent then c:ScaleTo(old) end end)
    end)
end
handlers.Gravity=function(_,s) s:Property(workspace,"Gravity",65) end
handlers.Speed=function(ctx,s) ctx:Each(function(_,h) s:Property(h,"WalkSpeed",28) end) end
handlers.BananaRain=function(c,s) Events.Rain(c,s,"Banana",1.3,40) end
handlers.DuckRain=function(c,s) Events.Rain(c,s,"Duck",1.5,40) end
handlers.Tornado=function(ctx,s)
    local center=Vector3.new(0,8,400) local rings={}
    for i=1,7 do local p=s:Add(ctx:Part("Twister",center,Vector3.new(i*3,2,i*3),Color3.fromRGB(170,150,230))) p.CanCollide=false p.Transparency=.6 table.insert(rings,p) end
    every(s,.1,function()
        local t=os.clock() center=Vector3.new(math.sin(t*.3)*28,3,400+math.cos(t*.3)*28)
        for i,p in rings do p.CFrame=CFrame.new(center+Vector3.new(0,i*3,0))*CFrame.Angles(0,t*3+i,0) end
        ctx:Each(function(p,_,r)
            local d=center-r.Position local horizontal=Vector3.new(d.X,0,d.Z)
            if horizontal.Magnitude&lt;24 and horizontal.Magnitude&gt;.5 then
                local force=horizontal.Unit*12+Vector3.new(-horizontal.Z,0,horizontal.X).Unit*10+Vector3.new(0,13,0)
                r:ApplyImpulse(force*r.AssemblyMass)
                if horizontal.Magnitude&lt;5 then Ragdoll.Start(p.Character,.5) end
            end
        end)
    end)
end
handlers.Ragdoll=function(ctx,s)
    ctx:Each(function(p) local c=p.Character Ragdoll.Start(c,2) s:Add(function() Ragdoll.Stop(c) end) end)
end
handlers.Slippery=function(ctx,s)
    for _,p in ctx.Map:GetDescendants() do
        if p:IsA("BasePart") and p.CanCollide then s:Property(p,"CustomPhysicalProperties",PhysicalProperties.new(.7,0,.2,100,1)) end
    end
    every(s,.15,function() ctx:Each(function(_,h,r) if h.FloorMaterial~=Enum.Material.Air then r:ApplyImpulse(h.MoveDirection*6*r.AssemblyMass) end end) end)
end
handlers.BeachBall=function(ctx,s)
    local ball=s:Add(ctx:Part("BeachBall",Vector3.new(0,15,400),Vector3.new(16,16,16),Color3.fromRGB(255,130,190))) ball.Shape=Enum.PartType.Ball
    every(s,.1,function()
        ball.Position=Vector3.new(math.sin(os.clock()*1.3)*28,10,400+math.cos(os.clock())*25)
        ctx:Each(function(p,_,r)
            local d=r.Position-ball.Position if d.Magnitude&lt;11 then Ragdoll.Start(p.Character,.7,(if d.Magnitude&gt;.1 then d.Unit else Vector3.xAxis)*35+Vector3.new(0,14,0)) end
        end)
    end)
end
local function attribute(ctx,s,key)
    ctx:Each(function(p) local old=p:GetAttribute(key) p:SetAttribute(key,true) s:Add(function() if p.Parent then p:SetAttribute(key,old) end end) end)
end
handlers.Reverse=function(c,s) attribute(c,s,"Reverse") end
handlers.Bounce=function(ctx,s) every(s,1.2,function() ctx:Each(function(_,_,r) r:ApplyImpulse(Vector3.new(0,45,0)*r.AssemblyMass) end) end) end
handlers.Teleport=function(ctx)
    local list={} local positions={} ctx:Each(function(p,_,r) table.insert(list,p) table.insert(positions,r.CFrame) end)
    for i,p in list do p.Character:PivotTo(positions[i%#positions+1]) end
end
handlers.Invisible=function(ctx,s)
    for _,p in ctx.Map:GetDescendants() do if p:IsA("BasePart") and p.CanCollide and p.Name~="MazeWall" then s:Property(p,"Transparency",.85) end end
end
handlers.Rainbow=function(_,s)
    local a=Lighting:FindFirstChildOfClass("Atmosphere")
    if a then
        s:Property(a,"Density",.48) s:Property(a,"Color",Color3.fromHSV(0,.4,1))
        every(s,.25,function() a.Color=Color3.fromHSV(os.clock()*.12%1,.4,1) end)
    end
end
handlers.GiantNPC=function(c,s) Events.Chaser(c,s,"Robot",Vector3.new(-30,5,370),12) end
handlers.Meteors=function(c,s) Events.Rain(c,s,"Ball",1,48) end
handlers.Jump=function(ctx,s) every(s,1.5,function() ctx:Each(function(_,h) h.Jump=true end) end) end
handlers.Camera=function(c,s) attribute(c,s,"ChaosCamera") end
handlers.Furniture=function(ctx,s)
    for i=1,4 do
        local p=s:Add(ctx:Part("FlyingSofa",Vector3.new(0,8,400),Vector3.new(12,3,5),Color3.fromRGB(160,110,220)))
        local back=s:Add(ctx:Part("SofaBack",p.Position,Vector3.new(12,5,1),p.Color)) back.CanCollide=false
        every(s,.1,function()
            local t=os.clock()+i*1.5 p.CFrame=CFrame.new(math.sin(t)*30,6,400+math.cos(t)*30)*CFrame.Angles(0,t,0)
            back.CFrame=p.CFrame*CFrame.new(0,3,2)
            ctx:Each(function(pl,_,r) if (r.Position-p.Position).Magnitude&lt;7 then Ragdoll.Start(pl.Character,1,(r.Position-p.Position).Unit*25+Vector3.new(0,15,0)) end end)
        end)
    end
end
handlers.Chickens=function(c,s) Events.Chaser(c,s,"Chicken",Vector3.new(30,5,425),10) Events.Chaser(c,s,"Chicken",Vector3.new(-30,5,375),10) end
handlers.Confetti=function(ctx,s) every(s,1,function() ctx:Each(function(_,_,r) ctx:Effect("Confetti",r.Position,Color3.fromHSV(ctx.Random:NextNumber(),.7,1)) end) end) end
handlers.Walls=function(ctx,s)
    local wall=s:Add(ctx:Part("MovingWall",Vector3.new(0,5,400),Vector3.new(3,10,55),Color3.fromRGB(255,130,160)))
    every(s,.1,function() wall.Position=Vector3.new(math.sin(os.clock()*.8)*35,5,400) end)
end
handlers.Rocket=function(ctx)
    ctx:Each(function(p,_,r) ctx:Effect("Rocket",r.Position) Ragdoll.Start(p.Character,1.3,Vector3.new(0,80,0)) end)
end
handlers.DoubleJump=function(c,s) attribute(c,s,"DoubleJump") end
Events.Handlers=handlers
function Events.Start(ctx,id,duration)
    if ctx.ActiveEvent or not ctx.Scope.Alive then return false end
    local handler=handlers[id] if not handler then return false end
    local scope=Scope.new() ctx.ActiveEvent=scope ctx.Scope:Add(function() scope:Clean() end)
    scope:Add(function() if ctx.ActiveEvent==scope then ctx.ActiveEvent=nil end end)
    local ok,err=xpcall(function() handler(ctx,scope) end,debug.traceback)
    if not ok then warn("NERO event:",id,err) scope:Clean() return false end
    ctx:Message("CHAOS: "..Catalog.EventById[id].Name)
    scope:Delay(duration or 8,function() scope:Clean() end)
    return true
end
function Events.Random(ctx)
    -- Teleport swaps can skip race checkpoints; moving walls can seal narrow obstacle paths.
    local list={}
    for _,e in Catalog.Events do
        if not (ctx.Info.Kind=="Race" and (e.Id=="Teleport" or e.Id=="Walls" or e.Id=="GiantNPC" or e.Id=="Chickens")) then table.insert(list,e.Id) end
    end
    return Events.Start(ctx,list[ctx.Random:NextInteger(1,#list)])
end
return Events
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX1376">
      <Properties>
        <string name="Name">Context</string>
        <ProtectedString name="Source">local Players=game:GetService("Players")
local Shared=game:GetService("ReplicatedStorage").Shared
local Scope=require(Shared.Scope)
local Ragdoll=require(script.Parent.Ragdoll)
local Context={} Context.__index=Context
function Context.new(gameInfo,players,remotes)
    local self=setmetatable({Info=gameInfo,Scope=Scope.new(),Players=players,Alive={},Finished={},Scores={},Started=os.clock(),Remotes=remotes,Random=Random.new(),LastPush={},LastJump={}},Context)
    self.Map=self.Scope:Add(game:GetService("ServerStorage").Maps[gameInfo.Id]:Clone()) self.Map.Parent=workspace
    self.Spawns=self.Map.Spawns:GetChildren() table.sort(self.Spawns,function(a,b) return tonumber(a.Name)&lt;tonumber(b.Name) end)
    self.Baseline={}
    for i,p in players do
        local hum,root=self:Character(p)
        if hum and root then
            self.Alive[p.UserId]=true self.Scores[p.UserId]=0
            self.Baseline[p]={Character=p.Character,Speed=hum.WalkSpeed,Jump=hum.JumpPower,Scale=p.Character:GetScale()}
            p:SetAttribute("InRound",true) p:SetAttribute("RoundScore",0)
            root.AssemblyLinearVelocity=Vector3.zero root.AssemblyAngularVelocity=Vector3.zero
            p.Character:PivotTo(self.Spawns[(i-1)%#self.Spawns+1].CFrame+Vector3.new(0,2,0))
            self.Scope:Add(hum.Died:Connect(function() self:Eliminate(p,false) end))
        end
    end
    self.Scope:Add(function()
        for p,base in self.Baseline do
            Ragdoll.Stop(base.Character)
            if base.Character.Parent then
                local h=base.Character:FindFirstChildOfClass("Humanoid")
                if h then h.WalkSpeed=base.Speed h.JumpPower=base.Jump end
                base.Character:ScaleTo(base.Scale)
            end
            p:SetAttribute("InRound",false) p:SetAttribute("DoubleJump",false)
            p:SetAttribute("Reverse",false) p:SetAttribute("ChaosCamera",false)
        end
    end)
    return self
end
function Context:Character(p)
    local c=p.Character local h=c and c:FindFirstChildOfClass("Humanoid") local r=c and c:FindFirstChild("HumanoidRootPart")
    if h and r and h.Health&gt;0 then return h,r end return nil,nil
end
function Context:Each(callback)
    for _,p in self.Players do
        if p.Parent and self.Alive[p.UserId] then local h,r=self:Character(p) if h and r then callback(p,h,r) end end
    end
end
function Context:Count() local n=0 for _,p in self.Players do if p.Parent and self.Alive[p.UserId] then n+=1 end end return n end
function Context:Message(text) self.Remotes.State:FireAllClients("Notice",text) end
function Context:Effect(name,pos,color) self.Remotes.Effect:FireAllClients(name,pos,color) end
function Context:Eliminate(p,teleport)
    if not self.Alive[p.UserId] then return end
    self.Alive[p.UserId]=false p:SetAttribute("InRound",false) p:SetAttribute("DoubleJump",false) p:SetAttribute("Reverse",false) p:SetAttribute("ChaosCamera",false)
    local h,r=self:Character(p)
    if h and r and teleport~=false then
        Ragdoll.Stop(p.Character)
        local base=self.Baseline[p] if base then h.WalkSpeed=base.Speed h.JumpPower=base.Jump p.Character:ScaleTo(base.Scale) end
        p.Character:PivotTo(workspace.Lobby.LobbySpawn.CFrame+Vector3.new(0,5,0))
        r.AssemblyLinearVelocity=Vector3.zero r.AssemblyAngularVelocity=Vector3.zero
    end
end
function Context:Finish(p)
    if not self.Alive[p.UserId] or self.Finished[p.UserId] then return end
    self.Finished[p.UserId]=math.floor((os.clock()-self.Started)*1000)
    self:Effect("Victory",p.Character:GetPivot().Position)
    self:Message(p.DisplayName.." hat das Ziel erreicht!") self:Eliminate(p)
end
function Context:PlayerFromHit(hit)
    local model=hit:FindFirstAncestorOfClass("Model")
    local p=model and Players:GetPlayerFromCharacter(model)
    if p and self.Alive[p.UserId] then return p end
end
function Context:Part(name,pos,size,color,parent)
    local p=Instance.new("Part") p.Name=name p.Anchored=true p.Size=size p.Position=pos p.Color=color or Color3.fromRGB(255,120,180)
    p.Material=Enum.Material.SmoothPlastic p.TopSurface=Enum.SurfaceType.Smooth p.BottomSurface=Enum.SurfaceType.Smooth
    p.Parent=parent or self.Map return p
end
function Context:Ground(p)
    local _,r=self:Character(p) if not r then return end
    local params=RaycastParams.new() params.FilterType=Enum.RaycastFilterType.Include params.FilterDescendantsInstances={self.Map}
    return workspace:Raycast(r.Position,Vector3.new(0,-6,0),params)
end
function Context:UpdateBounds()
    for _,p in self.Players do
        if self.Alive[p.UserId] then
            local h,r=self:Character(p)
            if not p.Parent or not h or not r then self:Eliminate(p,false)
            elseif r.Position.Y&lt; -18 or math.abs(r.Position.X)&gt;130 or math.abs(r.Position.Z-400)&gt;160 then self:Eliminate(p) end
        end
    end
end
function Context:Push(player)
    if self.Info.Id~="Sumo" or not self.Alive[player.UserId] then return end
    local _,root=self:Character(player) if not root then return end
    local now=os.clock() if now-(self.LastPush[player] or 0)&lt;1.5 then return end self.LastPush[player]=now
    self:Effect("Push",root.Position)
    self:Each(function(p,_,r)
        local offset=r.Position-root.Position
        if p~=player and offset.Magnitude&lt;10 and offset.Magnitude&gt;.05 and root.CFrame.LookVector:Dot(offset.Unit)&gt;-.1 then
            Ragdoll.Start(p.Character,.65,offset.Unit*42+Vector3.new(0,16,0))
        end
    end)
end
function Context:DoubleJump(player)
    if not player:GetAttribute("DoubleJump") or not self.Alive[player.UserId] then return end
    local h,r=self:Character(player) if not h then return end
    local now=os.clock() if now-(self.LastJump[player] or 0)&lt;1 then return end
    if h.FloorMaterial~=Enum.Material.Air then return end
    self.LastJump[player]=now r.AssemblyLinearVelocity=Vector3.new(r.AssemblyLinearVelocity.X,55,r.AssemblyLinearVelocity.Z)
end
return Context
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX1377">
      <Properties>
        <string name="Name">Cosmetics</string>
        <ProtectedString name="Source">local RS=game:GetService("ReplicatedStorage")
local Catalog=require(RS.Shared.Catalog)
local Cosmetics={}
local function color(p) local c=p.Color or {255,210,100} return Color3.fromRGB(c[1],c[2],c[3]) end
function Cosmetics.Apply(player,data)
    local character=player.Character
    for _,category in {"Pets","Trails","Hats","Wings","Costumes","Auras","Ragdoll","Victory"} do player:SetAttribute("Equipped"..category,data.Equipped[category]) end
    if not character then return end
    local old=character:FindFirstChild("NeroCosmetics") if old then old:Destroy() end
    for _,v in character:GetDescendants() do if v:IsA("Attachment") and v.Name=="NeroTrailAttachment" then v:Destroy() end end
    local folder=Instance.new("Folder") folder.Name="NeroCosmetics" folder.Parent=character
    local root=character:FindFirstChild("HumanoidRootPart") local head=character:FindFirstChild("Head") if not root or not head then return end
    for category,id in data.Equipped do
        local product=Catalog.ById[id]
        if product and data.Owned[id] then
            if category=="Trails" then
                local a=Instance.new("Attachment") a.Name="NeroTrailAttachment" a.Position=Vector3.new(-.7,0,.4) a.Parent=root
                local b=a:Clone() b.Position=Vector3.new(.7,0,.4) b.Parent=root
                local trail=Instance.new("Trail") trail.Attachment0=a trail.Attachment1=b trail.Lifetime=.65 trail.MinLength=.1 trail.FaceCamera=true
                trail.Color=if id=="RainbowTrail" then ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(255,100,160)),ColorSequenceKeypoint.new(.5,Color3.fromRGB(255,220,80)),ColorSequenceKeypoint.new(1,Color3.fromRGB(90,225,240))}) else ColorSequence.new(color(product))
                trail.Parent=folder
            elseif category=="Auras" then
                local highlight=Instance.new("Highlight") highlight.Adornee=character highlight.FillColor=color(product) highlight.FillTransparency=.8 highlight.OutlineTransparency=.3 highlight.DepthMode=Enum.HighlightDepthMode.Occluded highlight.Parent=folder
            elseif category=="Hats" or category=="Wings" or category=="Costumes" then
                local model=RS.Assets[product.Model]:Clone() model.Parent=folder
                local target=if category=="Hats" then head else root
                local offset=if category=="Hats" then CFrame.new(0,1.1,0) elseif category=="Wings" then CFrame.new(0,.5,1) else CFrame.new(0,-.2,-1)
                model:ScaleTo(if category=="Costumes" then 1.4 else 1)
                model:PivotTo(target.CFrame*offset)
                for _,p in model:GetDescendants() do
                    if p:IsA("BasePart") then
                        p.Anchored=false p.CanCollide=false p.CanTouch=false p.CanQuery=false p.Massless=true
                        local weld=Instance.new("WeldConstraint") weld.Part0=target weld.Part1=p weld.Parent=p
                    end
                end
            end
        end
    end
end
return Cosmetics
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX1378">
      <Properties>
        <string name="Name">DataService</string>
        <ProtectedString name="Source">local Players=game:GetService("Players")
local DSS=game:GetService("DataStoreService")
local Http=game:GetService("HttpService")
local Run=game:GetService("RunService")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Rules=require(Shared.Rules)
local Config=require(Shared.Config)
local Data={} Data.__index=Data
local function retry(callback)
    local last
    for attempt=1,4 do
        local ok,result=pcall(callback)
        if ok then return true,result end
        last=result
        if attempt&lt;4 then task.wait(math.min(2^(attempt-1),4)+math.random()*.3) end
    end
    return false,last
end
function Data.new(onChanged)
    local self=setmetatable({Profiles={},OnChanged=onChanged,Session=Http:GenerateGUID(false),Closing=false},Data)
    self.Ephemeral=Run:IsStudio() and not Config.StudioPersistence
    self.Store=if self.Ephemeral then nil else DSS:GetDataStore(Config.DataStoreName..(if Run:IsStudio() then "_Studio" else ""))
    task.spawn(function()
        while not self.Closing do
            task.wait(Config.AutoSaveSeconds)
            for player in self.Profiles do task.spawn(function() self:Save(player,false) end) end
        end
    end)
    return self
end
function Data:Load(player)
    local data,problem
    if self.Ephemeral then data=Rules.NewProfile()
    else
        local ok,record=retry(function()
            return self.Store:UpdateAsync(tostring(player.UserId),function(old)
                if old~=nil and (type(old)~="table" or not Rules.ValidProfile(old.Data)) then
                    problem="Beschädigtes oder neueres Profil. Es wurde nichts überschrieben." return nil
                end
                if old and old.Session and old.Session.Id~=self.Session and old.Session.Expires&gt;os.time() then
                    problem="Dein Profil ist noch auf einem anderen Server aktiv. Bitte kurz warten." return nil
                end
                problem=nil
                return {Data=if old then old.Data else Rules.NewProfile(),Session={Id=self.Session,Expires=os.time()+Config.SessionLeaseSeconds}}
            end)
        end)
        if not ok then problem="Speicherdienst nicht erreichbar. Bitte später erneut beitreten." warn("NERO load:",record)
        elseif record and record.Session and record.Session.Id==self.Session then data=record.Data end
    end
    if not data then if player.Parent then player:Kick(problem or "Profil konnte nicht geladen werden.") end return end
    self.Profiles[player]={Data=data,Revision=0,Saving=false,Closing=false,Joined=os.clock(),LastPlaytime=os.clock(),Failures=0}
    if not player.Parent or self.Closing then self:Remove(player) return end
    local stats=Instance.new("Folder") stats.Name="leaderstats" stats.Parent=player
    for _,name in {"Coins","Wins","Level"} do local n=Instance.new("IntValue") n.Name=name n.Parent=stats end
    self:Changed(player)
end
function Data:Get(player) local p=self.Profiles[player] return p and not p.Closing and p.Data end
function Data:Changed(player)
    local p=self.Profiles[player] if not p then return end
    local stats=player:FindFirstChild("leaderstats")
    if stats then stats.Coins.Value=p.Data.Coins stats.Wins.Value=p.Data.Wins stats.Level.Value=Rules.Level(p.Data.XP) end
    if self.OnChanged and player.Parent then self.OnChanged(player,Rules.Copy(p.Data),self.Ephemeral) end
end
function Data:Mutate(player,callback)
    local p=self.Profiles[player] if not p or p.Closing then return false,"Profil lädt noch." end
    -- No yielding inside callbacks; each mutation is atomic within this server's profile lease.
    local changed,message=callback(p.Data)
    if changed then p.Revision+=1 self:Changed(player) end
    return changed,message
end
function Data:Save(player,release)
    local p=self.Profiles[player] if not p then return true end
    if p.Saving then
        if not release then return false end
        local deadline=os.clock()+20 repeat task.wait(.1) until not p.Saving or os.clock()&gt;deadline
        if p.Saving then return false end
    end
    p.Saving=true
    local now=os.clock() local elapsed=math.floor(now-p.LastPlaytime)
    p.Data.Playtime+=elapsed p.LastPlaytime+=elapsed
    local snapshot=Rules.Copy(p.Data)
    local ok,result=true,nil
    if self.Store then
        ok,result=retry(function()
            local wrote=false
            local record=self.Store:UpdateAsync(tostring(player.UserId),function(old)
                if not old or not old.Session or old.Session.Id~=self.Session then return nil end
                wrote=true
                return {Data=snapshot,Session=if release then nil else {Id=self.Session,Expires=os.time()+Config.SessionLeaseSeconds}}
            end)
            if not wrote or not record then error("Profile lease was lost; refusing to overwrite") end
            return record
        end)
    end
    p.Saving=false
    if not ok then
        p.Failures+=1 warn("NERO save failed for",player.UserId,result)
        if player.Parent then
            player:SetAttribute("SaveWarning",true)
            -- Stop new rewards before the lease can expire and another server can load it.
            if p.Failures&gt;=2 and not release then p.Closing=true player:Kick("Speicherverbindung unterbrochen. Bitte erneut verbinden.") end
        end
    else
        p.Failures=0 p.SavedSnapshot=snapshot
        if player.Parent then player:SetAttribute("SaveWarning",false) end
    end
    return ok
end
function Data:Remove(player)
    local p=self.Profiles[player] if not p then return end p.Closing=true
    self:Save(player,true) self.Profiles[player]=nil
end
function Data:Shutdown()
    self.Closing=true local remaining=0
    for player in self.Profiles do remaining+=1 task.spawn(function() self:Remove(player) remaining-=1 end) end
    local deadline=os.clock()+25 repeat task.wait(.1) until remaining==0 or os.clock()&gt;deadline
end
return Data
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX1379">
      <Properties>
        <string name="Name">Items</string>
        <ProtectedString name="Source">local RS=game:GetService("ReplicatedStorage")
local Debris=game:GetService("Debris")
local Players=game:GetService("Players")
local Catalog=require(RS.Shared.Catalog)
local Ragdoll=require(script.Parent.Ragdoll)
local Items={Last={},Selected={}}
function Items.Select(player,id)
    if not Catalog.ItemById[id] then return false end
    Items.Selected[player]=id player:SetAttribute("PartyItem",id) return true
end
local function burst(remotes,name,pos) remotes.Effect:FireAllClients(name,pos) end
function Items.Use(player,remotes)
    if player:GetAttribute("InRound") then return end
    local definition=Catalog.ItemById[Items.Selected[player] or "Confetti"]
    local character=player.Character local root=character and character:FindFirstChild("HumanoidRootPart")
    local humanoid=character and character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or humanoid.Health&lt;=0 or math.abs(root.Position.Z)&gt;150 then return end
    if os.clock()-(Items.Last[player] or 0)&lt;definition.Cooldown then return end Items.Last[player]=os.clock()
    local hand=character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm") or root
    local prop=RS.Assets[definition.Model]:Clone() prop:ScaleTo(.65) prop:PivotTo(hand.CFrame*CFrame.new(0,-.8,-.6)) prop.Parent=workspace
    for _,part in prop:GetDescendants() do
        if part:IsA("BasePart") then part.Anchored=false part.Massless=true part.CanCollide=false part.CanTouch=false
            local weld=Instance.new("WeldConstraint") weld.Part0=hand weld.Part1=part weld.Parent=part end
    end
    Debris:AddItem(prop,1.2) remotes.Effect:FireAllClients("ItemSwing",player.UserId)
    burst(remotes,definition.Sound,root.Position)
    local id=definition.Id local position=root.Position local look=root.CFrame.LookVector
    if id=="Boots" then root.AssemblyLinearVelocity=Vector3.new(root.AssemblyLinearVelocity.X,75,root.AssemblyLinearVelocity.Z)
    elseif id=="Rocket" then Ragdoll.Start(character,1,Vector3.new(0,65,0)) burst(remotes,"Rocket",position)
    elseif id=="Confetti" or id=="Horn" or id=="Chicken" then burst(remotes,"Confetti",position)
    elseif id=="Peel" then
        local peel=RS.Assets.Banana:Clone() peel:ScaleTo(.8) peel:PivotTo(CFrame.new(position+look*5-Vector3.new(0,2.5,0))) peel.Parent=workspace Debris:AddItem(peel,8)
        local touched={}
        for _,part in peel:GetChildren() do
            if part:IsA("BasePart") then
                part.Touched:Connect(function(hit)
                    local model=hit:FindFirstAncestorOfClass("Model") local other=model and Players:GetPlayerFromCharacter(model)
                    if other and not other:GetAttribute("InRound") and not touched[other] then touched[other]=true Ragdoll.Start(model,1,look*15+Vector3.new(0,12,0)) end
                end)
            end
        end
    else
        local effectName=if id=="Water" then "Water" elseif id=="Bubble" then "Bubble" else "Push"
        burst(remotes,effectName,position+look*5)
        for _,other in Players:GetPlayers() do
            local c=other.Character local r=c and c:FindFirstChild("HumanoidRootPart")
            if other~=player and r and not other:GetAttribute("InRound") then
                local delta=r.Position-position
                if delta.Magnitude&lt;16 and delta.Magnitude&gt;.1 and look:Dot(delta.Unit)&gt;.55 then
                    if id=="Bubble" then r:ApplyImpulse(Vector3.new(0,35,0)*r.AssemblyMass) burst(remotes,"Bubble",r.Position)
                    else Ragdoll.Start(c,.8,delta.Unit*(if id=="Hammer" then 28 else 18)+Vector3.new(0,14,0)) end
                end
            end
        end
        if id=="Ball" then
            local ball=Instance.new("Part") ball.Name="ToyBeachBall" ball.Shape=Enum.PartType.Ball ball.Size=Vector3.new(5,5,5) ball.Color=Color3.fromRGB(255,135,190) ball.Position=position+look*7
            ball.CustomPhysicalProperties=PhysicalProperties.new(.3,.2,.8) ball.Parent=workspace ball:SetNetworkOwner(nil) ball.AssemblyLinearVelocity=look*32+Vector3.new(0,15,0) Debris:AddItem(ball,7)
        end
    end
end
function Items.Remove(player) Items.Last[player]=nil Items.Selected[player]=nil end
return Items
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX1380">
      <Properties>
        <string name="Name">Main</string>
        <ProtectedString name="Source">local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local Run=game:GetService("RunService")
local DSS=game:GetService("DataStoreService")
local Shared=RS:WaitForChild("Shared")
local Config=require(Shared.Config)
local Catalog=require(Shared.Catalog)
local Rules=require(Shared.Rules)
local DataService=require(script.Parent.DataService)
local Cosmetics=require(script.Parent.Cosmetics)
local Items=require(script.Parent.Items)
local Party=require(script.Parent.Party)
local RoundManager=require(script.Parent.RoundManager)
local Events=require(script.Parent.ChaosEvents)
local Ragdoll=require(script.Parent.Ragdoll)
local folder=Instance.new("Folder") folder.Name="Remotes" folder.Parent=RS
local remotes={}
for _,name in {"Request","State","Effect"} do local r=Instance.new("RemoteEvent") r.Name=name r.Parent=folder remotes[name]=r end
local data=DataService.new(function(p,profile,ephemeral) remotes.State:FireClient(p,"Profile",{Data=profile,SessionOnly=ephemeral}) end)
local rounds=RoundManager.new(data,remotes)
local party=Party.new(remotes.State)
local rates={} local emoteTimes={}
local function owner(p)
    return table.find(Config.OwnerUserIds,p.UserId)~=nil or (game.CreatorType==Enum.CreatorType.User and game.CreatorId==p.UserId)
end
local function notice(p,text) remotes.State:FireClient(p,"Notice",text) end
local function commit(p,callback)
    local ok,message=data:Mutate(p,callback)
    if message then notice(p,tostring(message)) end
    if ok then task.spawn(function() data:Save(p,false) end) end
    return ok
end
local function settings(p,payload)
    if type(payload)~="table" then return end
    local key,value=payload.Key,payload.Value
    if ((key=="Music" or key=="Effects" or key=="ReducedMotion") and type(value)=="boolean") or (key=="Quality" and (value=="High" or value=="Low")) then
        data:Mutate(p,function(d) d.Settings[key]=value return true end)
    end
end
local function admin(p,payload)
    if not owner(p) or type(payload)~="table" then return end
    local action=payload.Action local id=payload.Id
    if action=="SelectGame" and Catalog.GameById[id] then rounds.ForcedGame=id notice(p,"Nächstes Spiel: "..id)
    elseif action=="Start" then rounds.Skip=true notice(p,"Countdown übersprungen.")
    elseif action=="End" then rounds.Stop=true
    elseif action=="Event" and Catalog.EventById[id] and rounds.Context then
        if not Events.Start(rounds.Context,id) then notice(p,"Ein Chaos-Event läuft bereits.") end
    elseif action=="Status" then notice(p,string.format("Phase: %s · Spieler: %d · Profile: %d · Privatserver: %s",rounds.Phase,#Players:GetPlayers(),(function() local n=0 for _ in data.Profiles do n+=1 end return n end)(),tostring(game.PrivateServerId~="")))
    elseif action=="Coins" or action=="Wins" or action=="Teleport" or action=="Kick" then
        local target=if Rules.Finite(payload.UserId) then Players:GetPlayerByUserId(payload.UserId) else nil
        if not target then notice(p,"Spieler nicht auf diesem Server.") return end
        if action=="Coins" or action=="Wins" then
            if not Rules.Finite(payload.Amount) or payload.Amount%1~=0 or math.abs(payload.Amount)&gt;10000 then return end
            commit(target,function(d) d[action]=math.max(0,d[action]+payload.Amount) return true,"Owner-Test: "..action.." "..payload.Amount end)
        elseif action=="Teleport" then
            if target:GetAttribute("InRound") and rounds.Context then rounds.Context:Eliminate(target) end
            if target.Character then target.Character:PivotTo(workspace.Lobby.LobbySpawn.CFrame+Vector3.new(0,6,0)) end
        elseif action=="Kick" and target~=p then
            target:Kick("Du wurdest vom Owner aus diesem Server entfernt.")
        end
    end
end
remotes.Request.OnServerEvent:Connect(function(p,action,payload)
    if type(action)~="string" or #action&gt;32 then return end
    local now=os.clock() local rate=rates[p] or {At=now,Tokens=12} rates[p]=rate
    rate.Tokens=math.min(12,rate.Tokens+(now-rate.At)*5) rate.At=now
    if rate.Tokens&lt;1 then return end rate.Tokens-=1
    if type(payload)=="string" and #payload&gt;80 then return end
    local ok,err=xpcall(function()
        if action=="Hello" then
            data:Changed(p) remotes.State:FireClient(p,"Round",rounds.Last)
            remotes.State:FireClient(p,"Owner",owner(p)) party:Update() return
        end
        local profile=data:Get(p) if not profile then return end
        if action=="Vote" then if type(payload)=="string" then rounds:Vote(p,payload) end
        elseif action=="Play" then p:SetAttribute("AFK",false) notice(p,"Du spielst in der nächsten Runde mit.")
        elseif action=="AFK" then
            p:SetAttribute("AFK",not p:GetAttribute("AFK"))
            if p:GetAttribute("AFK") and rounds.Context then rounds.Context:Eliminate(p) end
            notice(p,if p:GetAttribute("AFK") then "AFK an – du setzt aus." else "AFK aus – nächste Runde geht's los!")
        elseif action=="Buy" then commit(p,function(d) return Rules.Buy(d,Catalog.ById[payload]) end)
        elseif action=="Equip" then
            local product=Catalog.ById[payload]
            if product and profile.Owned[payload] and product.Category~="Emotes" then
                data:Mutate(p,function(d) d.Equipped[product.Category]=if d.Equipped[product.Category]==payload then nil else payload return true end)
                Cosmetics.Apply(p,profile)
            end
        elseif action=="Favorite" then
            local product=Catalog.ById[payload]
            if product and product.Category=="Pets" and profile.Owned[payload] then data:Mutate(p,function(d) d.Favorites[payload]=if d.Favorites[payload] then nil else true return true end) end
        elseif action=="Daily" then commit(p,function(d) return Rules.Daily(d,Rules.Day(os.time()),Catalog.DailyCoins) end)
        elseif action=="Spin" then
            local roll=rounds.Random:NextInteger(1,100)
            local success,reward=data:Mutate(p,function(d) return Rules.Spin(d,Rules.Day(os.time()),roll) end)
            if success then remotes.State:FireClient(p,"Spin",reward) task.spawn(function() data:Save(p,false) end) else notice(p,reward) end
        elseif action=="Quest" then
            local quest for _,q in Catalog.Quests do if q.Id==payload then quest=q break end end
            commit(p,function(d) return Rules.Quest(d,quest) end)
        elseif action=="Settings" then settings(p,payload)
        elseif action=="SelectItem" then if Items.Select(p,payload) then notice(p,"Item gewählt: "..Catalog.ItemById[payload].Name) end
        elseif action=="UseItem" then Items.Use(p,remotes)
        elseif action=="Push" then if rounds.Context then rounds.Context:Push(p) end
        elseif action=="DoubleJump" then if rounds.Context then rounds.Context:DoubleJump(p) end
        elseif action=="Emote" then
            local product=Catalog.ById[payload]
            if product and product.Category=="Emotes" and profile.Owned[payload] and not p:GetAttribute("InRound") and now-(emoteTimes[p] or 0)&gt;2 then
                emoteTimes[p]=now remotes.Effect:FireAllClients("Emote",p.UserId,payload)
            end
        elseif action=="InviteParty" or action=="AcceptParty" or action=="LeaveParty" then local _,message=party:Request(p,action,payload) notice(p,message)
        elseif action=="Admin" then admin(p,payload) end
    end,debug.traceback)
    if not ok then warn("NERO request rejected:",action,err) end
end)
local function characterAdded(p,c)
    local h=c:WaitForChild("Humanoid",10) local root=c:WaitForChild("HumanoidRootPart",10) if not h or not root then return end
    h.BreakJointsOnDeath=false h.UseJumpPower=true
    p:SetAttribute("InRound",false) p:SetAttribute("Reverse",false) p:SetAttribute("DoubleJump",false) p:SetAttribute("ChaosCamera",false)
    if rounds.Context and rounds.Context.Alive[p.UserId] then rounds.Context:Eliminate(p,false) end
    c:PivotTo(workspace.Lobby.LobbySpawn.CFrame+Vector3.new(0,5,0))
    task.delay(1,function() local profile=data:Get(p) if profile and c.Parent then Cosmetics.Apply(p,profile) end end)
    local lastVelocity=0 local lastFall=0 local conn
    conn=Run.Heartbeat:Connect(function()
        if not c.Parent or h.Health&lt;=0 then conn:Disconnect() Ragdoll.Stop(c) return end
        if h.FloorMaterial==Enum.Material.Air then lastVelocity=root.AssemblyLinearVelocity.Y
        elseif lastVelocity&lt; -70 and os.clock()-lastFall&gt;3 then lastFall=os.clock() lastVelocity=0 Ragdoll.Start(c,.8)
        else lastVelocity=0 end
        if not p:GetAttribute("InRound") and root.Position.Y&lt; -25 then Ragdoll.Stop(c) c:PivotTo(workspace.Lobby.LobbySpawn.CFrame+Vector3.new(0,5,0)) root.AssemblyLinearVelocity=Vector3.zero end
    end)
end
local function joined(p)
    p:SetAttribute("AFK",false) Items.Select(p,"Confetti")
    p.CharacterAdded:Connect(function(c) characterAdded(p,c) end)
    p.CharacterAppearanceLoaded:Connect(function() local profile=data:Get(p) if profile then Cosmetics.Apply(p,profile) end end)
    if p.Character then task.spawn(characterAdded,p,p.Character) end
    data:Load(p)
end
Players.PlayerAdded:Connect(joined)
for _,p in Players:GetPlayers() do task.spawn(joined,p) end
Players.PlayerRemoving:Connect(function(p)
    if rounds.Context then rounds.Context:Eliminate(p,false) rounds.Votes[p.UserId]=nil end
    Items.Remove(p) party:Remove(p) rates[p]=nil emoteTimes[p]=nil data:Remove(p)
end)
game:BindToClose(function() data:Shutdown() end)
-- All lobby prompts verify proximity again on the server.
for _,object in workspace.Lobby:GetDescendants() do
    if object:IsA("ProximityPrompt") then
        object.Triggered:Connect(function(p)
            local r=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            if not r or p:GetAttribute("InRound") or not data:Get(p) or (r.Position-object.Parent.Position).Magnitude&gt;18 then return end
            local name=object.Parent.Name
            if name=="AFK" then p:SetAttribute("AFK",not p:GetAttribute("AFK")) notice(p,if p:GetAttribute("AFK") then "AFK aktiviert." else "AFK deaktiviert.")
            elseif name=="VIP" then
                if owner(p) or table.find(Config.VipUserIds,p.UserId) then p.Character:PivotTo(workspace.Lobby.VipSpawn.CFrame) notice(p,"Willkommen in der VIP-Lounge!")
                else notice(p,"Diese Lounge ist für vom Owner eingetragene Gäste. Keine Spielvorteile.") end
            elseif name=="Photo" then remotes.Effect:FireClient(p,"Photo",object.Parent.Position) remotes.Effect:FireAllClients("Emote",p.UserId,"VictoryPose")
            else remotes.State:FireClient(p,"Open",if name=="SpinWheel" then "Rewards" else name) end
        end)
    elseif object:IsA("BasePart") and object.Name=="Trampoline" then
        local last={}
        object.Touched:Connect(function(hit)
            local c=hit:FindFirstAncestorOfClass("Model") local p=c and Players:GetPlayerFromCharacter(c)
            local r=c and c:FindFirstChild("HumanoidRootPart")
            if p and r and not p:GetAttribute("InRound") and os.clock()-(last[p] or 0)&gt;1 then last[p]=os.clock() r.AssemblyLinearVelocity=Vector3.new(r.AssemblyLinearVelocity.X,90,r.AssemblyLinearVelocity.Z) remotes.Effect:FireAllClients("Bounce",r.Position) end
        end)
    end
end
-- Only persisted profiles feed global boards. Studio session scores are labeled separately.
local boardSpecs={{Name="Wins",Board="WinsBoard",Title="MOST WINS"},{Name="Level",Board="LevelBoard",Title="HIGHEST LEVEL"},{Name="Playtime",Board="TimeBoard",Title="MOST PLAYTIME"}}
local names={}
local function displayName(id)
    if not names[id] then local ok,name=pcall(Players.GetNameFromUserIdAsync,Players,id) names[id]=if ok then name else tostring(id) end return names[id]
end
task.spawn(function()
    while true do
        for _,spec in boardSpecs do
            local values={}
            if data.Ephemeral then
                for p,record in data.Profiles do table.insert(values,{key=tostring(p.UserId),value=if spec.Name=="Level" then Rules.Level(record.Data.XP) else record.Data[spec.Name]}) end
                table.sort(values,function(a,b) return a.value&gt;b.value end)
            else
                local store=DSS:GetOrderedDataStore(Config.DataStoreName..(if Run:IsStudio() then "_Studio" else "").."_"..spec.Name)
                for p,record in data.Profiles do
                    if record.SavedSnapshot then
                        local snapshot=record.SavedSnapshot
                        local value=if spec.Name=="Level" then Rules.Level(snapshot.XP) else snapshot[spec.Name]
                        local ok,err=pcall(function() store:SetAsync(tostring(p.UserId),value) end) if not ok then warn("NERO leaderboard save:",err) end
                    end
                end
                local ok,pages=pcall(function() return store:GetSortedAsync(false,5) end)
                if ok then values=pages:GetCurrentPage() end
            end
            local lines={spec.Title..(if data.Ephemeral then " · STUDIO" else "")}
            for i=1,math.min(5,#values) do
                local v=values[i] local value=if spec.Name=="Playtime" then tostring(math.floor(v.value/60)).." min" else tostring(v.value)
                table.insert(lines,i..". "..displayName(tonumber(v.key)).." · "..value)
            end
            if #values==0 then table.insert(lines,"Noch keine gespeicherten Einträge") end
            workspace.Lobby[spec.Board].Sign.Text.Text=table.concat(lines,"\n")
        end
        task.wait(120)
    end
end)
rounds:Start()
print("NERO CHAOS PARTY "..Config.Version.." ready · "..#Catalog.Games.." minigames · "..#Catalog.Events.." chaos events")
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX1381">
      <Properties>
        <string name="Name">Minigames</string>
        <ProtectedString name="Source">local RS=game:GetService("ReplicatedStorage")
local Events=require(script.Parent.ChaosEvents)
local Scope=require(RS.Shared.Scope)
local Ragdoll=require(script.Parent.Ragdoll)
local Games={}
local function loop(ctx,seconds,fn) Events.Every(ctx.Scope,seconds,fn) end
local function touch(ctx,part,fn)
    ctx.Scope:Add(part.Touched:Connect(function(hit) local p=ctx:PlayerFromHit(hit) if p then fn(p,hit) end end))
end
local function finish(ctx)
    touch(ctx,ctx.Map.Finish,function(p) ctx:Finish(p) end)
end
local function sizedHeads(ctx)
    Events.Handlers.GiantHead(ctx,ctx.Scope)
    ctx:Each(function(_,h) ctx.Scope:Property(h,"WalkSpeed",14) end)
end
Games.Lava=function(ctx)
    local lava=ctx.Map.Lava local disappearing={}
    loop(ctx,.1,function()
        local age=os.clock()-ctx.Started lava.Position=Vector3.new(0,-3+age*.43,400)
        ctx:Each(function(p,_,r) if r.Position.Y&lt;lava.Position.Y+2 then ctx:Eliminate(p) end end)
    end)
    loop(ctx,7,function()
        local choices={}
        for _,v in ctx.Map:GetChildren() do if v.Name=="Platform" and v.Position.Y&lt;28 and not disappearing[v] then table.insert(choices,v) end end
        if #choices&gt;0 then
            local p=choices[ctx.Random:NextInteger(1,#choices)] disappearing[p]=true p.Color=Color3.fromRGB(255,245,60)
            ctx.Scope:Delay(1.5,function() p.CanCollide=false p.Transparency=1 end)
        end
    end)
end
Games.Bananas=function(ctx) Events.Rain(ctx,ctx.Scope,"Banana",.8,52) end
Games.Button=function(ctx)
    local last=0
    ctx.Scope:Add(ctx.Map.ChaosButton.Prompt.Triggered:Connect(function(p)
        local _,r=ctx:Character(p)
        if ctx.Alive[p.UserId] and r and (r.Position-ctx.Map.ChaosButton.Position).Magnitude&lt;14 and os.clock()-last&gt;3 then
            if Events.Random(ctx) then last=os.clock() end
        end
    end))
    Events.Rain(ctx,ctx.Scope,"Ball",8,30)
end
Games.Duck=function(ctx) finish(ctx) Events.Chaser(ctx,ctx.Scope,"Duck",Vector3.new(0,5,316),13) end
Games.Ice=function(ctx)
    Events.Handlers.Slippery(ctx,ctx.Scope)
    loop(ctx,4,function()
        local direction=Vector3.new(ctx.Random:NextNumber(-1,1),0,ctx.Random:NextNumber(-1,1))
        ctx:Message("WINDSTOSS!") ctx:Each(function(_,_,r) r:ApplyImpulse(direction*25*r.AssemblyMass) end)
    end)
    Events.Rain(ctx,ctx.Scope,"Ball",3,35)
end
Games.Disasters=function(ctx)
    local cycle=0
    loop(ctx,12,function()
        cycle+=1
        if ctx.ActiveEvent then ctx.ActiveEvent:Clean() end
        if cycle%3==0 then
            local scope=Scope.new() ctx.Scope:Add(function() scope:Clean() end)
            local water=scope:Add(ctx:Part("Flood",Vector3.new(0,-2,400),Vector3.new(100,1,100),Color3.fromRGB(70,175,255))) water.CanCollide=false water.Transparency=.35
            local start=os.clock() ctx:Message("FLUT! Klettere auf die Türme!")
            Events.Every(scope,.1,function()
                water.Position=Vector3.new(0,math.min(7,(os.clock()-start)*1.4)-2,400)
                ctx:Each(function(p,_,r) if r.Position.Y&lt;water.Position.Y then ctx:Eliminate(p) end end)
            end)
            scope:Delay(9,function() scope:Clean() end)
        elseif cycle%3==1 then Events.Start(ctx,"Tornado",9)
        else Events.Start(ctx,"Meteors",9) end
    end)
end
Games.Music=function(ctx)
    local tiles=ctx.Map.Tiles:GetChildren() local colors={} for _,p in tiles do colors[p]=p.Color end
    local cycle=0
    loop(ctx,10,function()
        cycle+=1 local safe={}
        for _,p in tiles do p.CanCollide=true p.Transparency=0 p.Color=colors[p] end
        local count=math.max(7,30-cycle*2)
        local shuffled=table.clone(tiles)
        for i=#shuffled,2,-1 do local j=ctx.Random:NextInteger(1,i) shuffled[i],shuffled[j]=shuffled[j],shuffled[i] end
        for i=1,count do safe[shuffled[i]]=true end
        ctx.Remotes.State:FireAllClients("Music",true) ctx:Message("Tanzen! Gleich stoppt die Musik …")
        ctx.Scope:Delay(5,function()
            ctx.Remotes.State:FireAllClients("Music",false) ctx:Message("STOPP! Auf die GRÜNEN Plattformen!")
            for _,p in tiles do p.Color=if safe[p] then Color3.fromRGB(90,255,145) else Color3.fromRGB(255,90,110) end
        end)
        ctx.Scope:Delay(7,function() for _,p in tiles do if not safe[p] then p.CanCollide=false p.Transparency=1 end end end)
    end)
end
local function obstacleRace(ctx,heads)
    finish(ctx) if heads then sizedHeads(ctx) end
    for _,v in ctx.Map:GetChildren() do
        if v.Name=="Spinner" then
            local base=v.CFrame
            loop(ctx,.05,function() v.CFrame=base*CFrame.Angles(0,(os.clock()-ctx.Started)*1.5,0) end)
            local cooldown={}
            touch(ctx,v,function(p)
                if os.clock()-(cooldown[p] or 0)&gt;1 then cooldown[p]=os.clock() Ragdoll.Start(p.Character,.6,Vector3.new(18,15,10)) end
            end)
        elseif v.Name=="Moving" then
            local base=v.Position
            loop(ctx,.05,function() v.Position=base+Vector3.new(math.sin((os.clock()-ctx.Started)*.8)*7,0,0) end)
        elseif v.Name=="Spring" then
            local last={}
            touch(ctx,v,function(p)
                local _,r=ctx:Character(p)
                if r and os.clock()-(last[p] or 0)&gt;.7 then last[p]=os.clock() r.AssemblyLinearVelocity=Vector3.new(r.AssemblyLinearVelocity.X,65,23) ctx:Effect("Bounce",r.Position) end
            end)
        end
    end
    if not heads then Events.Rain(ctx,ctx.Scope,"Banana",7,20) end
end
Games.Race=function(ctx) obstacleRace(ctx,false) end
Games.Heads=function(ctx) obstacleRace(ctx,true) end
Games.Potato=function(ctx)
    local carrier,deadline,lastPass=nil,os.clock()+12,0
    local potato=ctx.Scope:Add(ctx:Part("HotPotato",Vector3.new(0,8,400),Vector3.new(3,3,3),Color3.fromRGB(255,135,60))) potato.Shape=Enum.PartType.Ball potato.CanCollide=false potato.Material=Enum.Material.Neon
    local function choose()
        local list={} ctx:Each(function(p) table.insert(list,p) end)
        carrier=if #list&gt;0 then list[ctx.Random:NextInteger(1,#list)] else nil
        deadline=os.clock()+12 lastPass=os.clock()
    end
    choose()
    local lastSecond=-1
    loop(ctx,.1,function()
        if not carrier or not ctx.Alive[carrier.UserId] then choose() end
        if not carrier then return end
        local _,r=ctx:Character(carrier) if not r then choose() return end
        potato.Position=r.Position+Vector3.new(0,4,0)
        local now=os.clock() local seconds=math.ceil(deadline-now)
        if seconds~=lastSecond then lastSecond=seconds ctx:Message("KARTOFFEL: "..carrier.DisplayName.." · "..seconds.."s") end
        if now&gt;=deadline then
            if #ctx.Players==1 then
                -- Solo variant: drop the potato at the blue bumper before each fuse expires.
                ctx:Eliminate(carrier)
            else ctx:Effect("Explosion",r.Position) ctx:Eliminate(carrier) end
            choose()
        elseif #ctx.Players==1 then
            if (r.Position-Vector3.new(25,3,400)).Magnitude&lt;9 then
                ctx.Scores[carrier.UserId]+=1 deadline=now+12
                ctx:Message("Kartoffel abgekühlt! +1")
                carrier.Character:PivotTo(CFrame.new(-25,5,400))
            end
        elseif now-lastPass&gt;1 then
            ctx:Each(function(p,_,other)
                if p~=carrier and now-lastPass&gt;1 and (other.Position-r.Position).Magnitude&lt;5 then
                    carrier=p lastPass=now lastSecond=-1
                end
            end)
        end
    end)
    if #ctx.Players==1 then ctx:Message("SOLO: Bring die Kartoffel alle 12s zum rechten Bumper!") end
end
Games.Color=function(ctx)
    local tiles=ctx.Map.Tiles:GetChildren() local names={"PINK","TÜRKIS","GELB","LILA","GRÜN","ORANGE"}
    loop(ctx,9,function()
        for _,p in tiles do p.CanCollide=true p.Transparency=0 end
        local color=ctx.Random:NextInteger(1,6) ctx:Message("FARBE: "..names[color].." — 5 SEKUNDEN!")
        ctx.Remotes.State:FireAllClients("Color",color)
        ctx.Scope:Delay(5,function()
            for _,p in tiles do if tonumber(p.Name:match("_(%d+)$"))~=color then p.CanCollide=false p.Transparency=1 end end
        end)
    end)
end
Games.TNT=function(ctx)
    local triggered={}
    loop(ctx,.08,function()
        ctx:Each(function(p)
            local hit=ctx:Ground(p)
            if hit and hit.Instance.Parent==ctx.Map.Tiles and not triggered[hit.Instance] then
                local tile=hit.Instance triggered[tile]=true tile.Color=Color3.fromRGB(255,90,70)
                ctx.Scope:Delay(.65,function() tile.CanCollide=false tile.Transparency=1 end)
            end
        end)
    end)
end
Games.Flying=function(ctx)
    ctx.Scope:Property(workspace,"Gravity",48)
    ctx:Each(function(_,h) ctx.Scope:Property(h,"JumpPower",48) end)
    local targets={} local rings=ctx.Map.Rings:GetChildren()
    table.sort(rings,function(a,b) return tonumber(a.Name:match('%d+'))&lt;tonumber(b.Name:match('%d+')) end)
    loop(ctx,.1,function()
        ctx:Each(function(p,_,r)
            local nextIndex=(ctx.Scores[p.UserId] or 0)%#rings+1
            local target=rings[nextIndex].Center
            if targets[p]~=nextIndex then targets[p]=nextIndex ctx.Remotes.State:FireClient(p,"Target",target.Position) end
            if (r.Position-target.Position).Magnitude&lt;6 then
                ctx.Scores[p.UserId]+=1 p:SetAttribute("RoundScore",ctx.Scores[p.UserId]) ctx:Effect("Bounce",target.Position)
                if ctx.Scores[p.UserId]&gt;=10 then ctx.Finished[p.UserId]=os.clock()-ctx.Started ctx:Eliminate(p) end
            end
        end)
    end)
    loop(ctx,6,function()
        local wind=Vector3.new(ctx.Random:NextNumber(-12,12),5,ctx.Random:NextNumber(-12,12))
        ctx:Each(function(_,_,r) r:ApplyImpulse(wind*r.AssemblyMass) end) ctx:Message("WIND! Folge deinem goldenen Zielmarker.")
    end)
end
Games.Sumo=function(ctx)
    loop(ctx,12,function()
        local f=ctx.Map.Floor f.Size=Vector3.new(2,math.max(26,f.Size.Y-6),math.max(26,f.Size.Z-6)) ctx:Message("Der Ring schrumpft!")
    end)
end
Games.Doors=function(ctx)
    local safe={} local stage={} local cooldown={}
    for row=1,4 do safe[row]=ctx.Random:NextInteger(1,3) end
    for _,door in ctx.Map.Doors:GetChildren() do
        local row,col=door.Name:match('Door_(%d+)_(%d+)') row=tonumber(row) col=tonumber(col)
        touch(ctx,door,function(p)
            local now=os.clock() if now-(cooldown[p] or 0)&lt;1 then return end cooldown[p]=now
            local current=stage[p] or 1
            if row~=current then return end
            if col==safe[row] then
                stage[p]=row+1 p.Character:PivotTo(CFrame.new(door.Position+Vector3.new(0,1,8))) ctx:Effect("Victory",door.Position)
            else
                local choice=ctx.Random:NextInteger(1,3) local _,r=ctx:Character(p)
                if choice==1 then Ragdoll.Start(p.Character,1,Vector3.new(0,40,-38))
                elseif choice==2 then p.Character:PivotTo(CFrame.new(0,5,door.Position.Z-15)) ctx:Effect("Confetti",door.Position)
                else r.AssemblyLinearVelocity=Vector3.new(ctx.Random:NextNumber(-28,28),18,-45) ctx:Effect("Bounce",door.Position) end
            end
        end)
    end
    touch(ctx,ctx.Map.Finish,function(p) if stage[p]==5 then ctx:Finish(p) else p.Character:PivotTo(CFrame.new(0,5,340+((stage[p] or 1)-1)*40)) end end)
    -- Enforce checkpoint order even if a player jumps around a door frame.
    loop(ctx,.2,function()
        ctx:Each(function(p,_,r)
            local nextRow=stage[p] or 1
            if nextRow&lt;=4 and r.Position.Z&gt;355+(nextRow-1)*40+5 then p.Character:PivotTo(CFrame.new(0,5,340+(nextRow-1)*40)) end
        end)
    end)
end
function Games.Start(ctx)
    local start=Games[ctx.Info.Id] assert(start,"Missing minigame: "..ctx.Info.Id) start(ctx)
end
return Games
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX1382">
      <Properties>
        <string name="Name">Party</string>
        <ProtectedString name="Source">local Players=game:GetService("Players")
local Party={} Party.__index=Party
function Party.new(state) return setmetatable({Leaders={},Invites={},Remote=state},Party) end
function Party:Update()
    for _,p in Players:GetPlayers() do
        local leader=self.Leaders[p.UserId] or p.UserId local members={}
        for _,other in Players:GetPlayers() do
            if (self.Leaders[other.UserId] or other.UserId)==leader then table.insert(members,{Id=other.UserId,Name=other.DisplayName}) end
        end
        self.Remote:FireClient(p,"Party",{Leader=leader,Members=members})
    end
end
function Party:Request(player,action,targetId)
    if action=="LeaveParty" then
        if self.Leaders[player.UserId]==player.UserId then
            for id,leader in self.Leaders do if leader==player.UserId then self.Leaders[id]=nil end end
        else self.Leaders[player.UserId]=nil end
        self:Update() return true,"Gruppe verlassen."
    end
    if type(targetId)~="number" then return false,"Ungültiger Spieler." end
    local target=Players:GetPlayerByUserId(targetId) if not target or target==player then return false,"Spieler nicht verfügbar." end
    if action=="InviteParty" then
        local leader=self.Leaders[player.UserId] or player.UserId
        if leader~=player.UserId then return false,"Nur der Gruppenleiter lädt ein." end
        self.Invites[targetId]={Leader=leader,Until=os.clock()+30}
        self.Remote:FireClient(target,"PartyInvite",{Id=player.UserId,Name=player.DisplayName})
        return true,"Einladung gesendet."
    elseif action=="AcceptParty" then
        local invite=self.Invites[player.UserId]
        if not invite or invite.Leader~=targetId or invite.Until&lt;os.clock() then return false,"Einladung abgelaufen." end
        if self.Leaders[player.UserId] and self.Leaders[player.UserId]~=player.UserId then return false,"Verlasse zuerst deine andere Gruppe." end
        for id,leader in self.Leaders do if leader==player.UserId then self.Leaders[id]=nil end end
        self.Leaders[targetId]=targetId self.Leaders[player.UserId]=targetId self.Invites[player.UserId]=nil
        self:Update() return true,"Gruppe beigetreten. Alle spielen auf diesem Server gemeinsam."
    end
    return false,"Unbekannte Gruppenaktion."
end
function Party:Remove(player)
    for id,leader in self.Leaders do if id==player.UserId or leader==player.UserId then self.Leaders[id]=nil end end
    self.Invites[player.UserId]=nil self:Update()
end
return Party
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX1383">
      <Properties>
        <string name="Name">Ragdoll</string>
        <ProtectedString name="Source">local Ragdoll={Active={}}
function Ragdoll.Stop(character)
    local state=Ragdoll.Active[character] if not state then return end
    Ragdoll.Active[character]=nil
    for _,joint in state.Joints do if joint.Parent then joint.Enabled=true end end
    for _,part in state.Parts do if part.Parent then part.CanCollide=state.Collision[part] end end
    for _,v in state.Created do v:Destroy() end
    local humanoid=character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health&gt;0 then
        humanoid.PlatformStand=false humanoid.AutoRotate=state.AutoRotate
        humanoid.RequiresNeck=state.RequiresNeck
        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
    character:SetAttribute("Ragdolled",false)
end
function Ragdoll.Start(character,duration,impulse)
    local root=character and character:FindFirstChild("HumanoidRootPart")
    local hum=character and character:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health&lt;=0 then return end
    if impulse then root:ApplyImpulse(impulse*root.AssemblyMass) end
    local existing=Ragdoll.Active[character]
    if existing then existing.Until=math.max(existing.Until,os.clock()+duration) return end
    local state={Until=os.clock()+duration,Joints={},Parts={},Collision={},Created={},AutoRotate=hum.AutoRotate,RequiresNeck=hum.RequiresNeck}
    Ragdoll.Active[character]=state
    hum.RequiresNeck=false hum.AutoRotate=false hum.PlatformStand=true
    for _,v in character:GetDescendants() do
        if v:IsA("Motor6D") and v.Part0 and v.Part1 and v.Name~="RootJoint" and v.Name~="Root" then
            local a=Instance.new("Attachment") a.CFrame=v.C0 a.Parent=v.Part0
            local b=Instance.new("Attachment") b.CFrame=v.C1 b.Parent=v.Part1
            local socket=Instance.new("BallSocketConstraint") socket.Attachment0=a socket.Attachment1=b
            socket.LimitsEnabled=true socket.UpperAngle=45 socket.TwistLimitsEnabled=true socket.TwistLowerAngle=-35 socket.TwistUpperAngle=35 socket.Parent=v.Part0
            local no=Instance.new("NoCollisionConstraint") no.Part0=v.Part0 no.Part1=v.Part1 no.Parent=v.Part0
            table.insert(state.Created,a) table.insert(state.Created,b) table.insert(state.Created,socket) table.insert(state.Created,no)
            table.insert(state.Joints,v) v.Enabled=false
        elseif v:IsA("BasePart") and v~=root and v.Parent==character then
            table.insert(state.Parts,v) state.Collision[v]=v.CanCollide v.CanCollide=true
        end
    end
    character:SetAttribute("Ragdolled",true)
    task.spawn(function()
        while character.Parent and Ragdoll.Active[character]==state and os.clock()&lt;state.Until do task.wait(.15) end
        if Ragdoll.Active[character]==state then Ragdoll.Stop(character) end
    end)
end
return Ragdoll
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX1384">
      <Properties>
        <string name="Name">RoundManager</string>
        <ProtectedString name="Source">local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local Http=game:GetService("HttpService")
local Config=require(RS.Shared.Config)
local Catalog=require(RS.Shared.Catalog)
local Rules=require(RS.Shared.Rules)
local Context=require(script.Parent.Context)
local Minigames=require(script.Parent.Minigames)
local Events=require(script.Parent.ChaosEvents)
local Round={} Round.__index=Round
function Round.new(data,remotes)
    return setmetatable({Data=data,Remotes=remotes,Phase="Waiting",Choices={},Votes={},Context=nil,ForcedGame=nil,Skip=false,Stop=false,Last={},Random=Random.new()},Round)
end
function Round:Eligible()
    local result={}
    for _,p in Players:GetPlayers() do
        local h=p.Character and p.Character:FindFirstChildOfClass("Humanoid")
        if self.Data:Get(p) and not p:GetAttribute("AFK") and h and h.Health&gt;0 and p.Character:FindFirstChild("HumanoidRootPart") then table.insert(result,p) end
    end
    return result
end
function Round:Broadcast(seconds,extra)
    local ctx=self.Context local counts={}
    if #self.Choices&gt;0 then local _;_,counts=Rules.VoteWinner(self.Choices,self.Votes,1) end
    self.Last={Phase=self.Phase,Seconds=seconds,Choices=self.Choices,Votes=counts,
        Game=ctx and ctx.Info.Id or nil,Alive=ctx and ctx:Count() or #self:Eligible(),Message=extra or "",Players=#Players:GetPlayers()}
    self.Remotes.State:FireAllClients("Round",self.Last)
end
function Round:Wait(seconds,extra)
    for remaining=seconds,1,-1 do
        self:Broadcast(remaining,extra) task.wait(1)
        if self.Skip then self.Skip=false return end
    end
end
function Round:Vote(player,id)
    if self.Phase~="Voting" or not table.find(self.Choices,id) or not self.Data:Get(player) or player:GetAttribute("AFK") then return end
    self.Votes[player.UserId]=id self:Broadcast(self.Last.Seconds or 0)
end
function Round:RunOne()
    self.Phase="Waiting" self.Choices={} self.Votes={}
    while #self:Eligible()&lt;Config.MinimumPlayers do self:Broadcast(0,"Drücke PLAY, um mitzuspielen.") task.wait(1) end
    self.Phase="Intermission" self:Wait(Config.Intermission,"Die nächste Runde wartet!")
    local pool=table.clone(Catalog.Games)
    for i=#pool,2,-1 do local j=self.Random:NextInteger(1,i) pool[i],pool[j]=pool[j],pool[i] end
    self.Choices={pool[1].Id,pool[2].Id,pool[3].Id} self.Votes={} self.Phase="Voting"
    self:Wait(Config.VotingTime,"Wähle ein Minispiel.")
    local chosen=self.ForcedGame or Rules.VoteWinner(self.Choices,self.Votes,self.Random:NextInteger(1,1000)) self.ForcedGame=nil
    local players=self:Eligible() if #players==0 then return end
    local ctx=Context.new(Catalog.GameById[chosen],players,self.Remotes) self.Context=ctx self.Stop=false
    self.Phase="Playing" self.Choices={} ctx:Message(ctx.Info.Rules)
    Minigames.Start(ctx)
    local lastSecond=-1 local nextChaos=Config.ChaosInterval local firstFinish=nil
    while ctx.Scope.Alive do
        task.wait(.1) ctx:UpdateBounds()
        local elapsed=os.clock()-ctx.Started local remaining=math.max(0,math.ceil(ctx.Info.Duration-elapsed))
        if remaining~=lastSecond then lastSecond=remaining self:Broadcast(remaining,ctx.Info.Rules) end
        if elapsed&gt;=nextChaos then
            nextChaos+=Config.ChaosInterval
            if chosen~="Disasters" then Events.Random(ctx) end
        end
        if next(ctx.Finished) and not firstFinish then firstFinish=elapsed end
        if self.Stop or remaining&lt;=0 or ctx:Count()==0 then break end
        if #players&gt;1 and ctx.Info.Kind=="Survival" and ctx:Count()&lt;=1 and elapsed&gt;6 then break end
        if firstFinish and ctx.Info.Kind=="Race" and elapsed-firstFinish&gt;=15 then break end
    end
    local eligible={} for _,p in players do if p.Parent and self.Data:Get(p) then eligible[p.UserId]=true end end
    local winners=if self.Stop then {} else Rules.Winners(ctx.Info.Kind,ctx.Alive,ctx.Finished,ctx.Scores,eligible)
    local receipt=Http:GenerateGUID(false) local names={}
    if not self.Stop then
        for _,p in players do
            if p.Parent and self.Data:Get(p) then
                local survived=ctx.Alive[p.UserId] or ctx.Finished[p.UserId]~=nil
                self.Data:Mutate(p,function(d)
                    local changed=Rules.RoundReward(d,receipt,survived,winners[p.UserId]==true)
                    if changed then Rules.ProgressRewards(d,Catalog.Achievements) end return changed
                end)
                task.spawn(function() self.Data:Save(p,false) end)
                if winners[p.UserId] then table.insert(names,p.DisplayName) end
            end
        end
    end
    ctx.Scope:Clean()
    for _,p in players do
        if p.Parent and p.Character then
            local r=p.Character:FindFirstChild("HumanoidRootPart")
            if r then p.Character:PivotTo(workspace.Lobby.LobbySpawn.CFrame+Vector3.new(self.Random:NextNumber(-8,8),5,self.Random:NextNumber(-8,8))) r.AssemblyLinearVelocity=Vector3.zero end
            if winners[p.UserId] then
                self.Remotes.Effect:FireAllClients("Victory",p.Character:GetPivot().Position)
                self.Remotes.Effect:FireAllClients("Emote",p.UserId,"VictoryPose")
                if p:GetAttribute("EquippedVictory")=="ConfettiWin" then self.Remotes.Effect:FireAllClients("Confetti",p.Character:GetPivot().Position) end
            end
        end
    end
    self.Context=nil self.Phase="Results"
    self.Remotes.State:FireAllClients("Target",false) self.Remotes.State:FireAllClients("Music",false)
    self:Wait(Config.ResultsTime,if self.Stop then "Runde abgebrochen – keine Wertung." elseif #names&gt;0 then "GEWONNEN: "..table.concat(names,", ") else "Das Chaos hat gewonnen. Nächster Versuch!")
end
function Round:Start()
    task.spawn(function()
        while true do
            local ok,err=xpcall(function() self:RunOne() end,debug.traceback)
            if not ok then
                warn("NERO round recovered:",err)
                if self.Context then
                    local ctx=self.Context ctx.Scope:Clean()
                    for _,p in ctx.Players do if p.Character then p.Character:PivotTo(workspace.Lobby.LobbySpawn.CFrame+Vector3.new(0,5,0)) end end
                    self.Context=nil
                end
                self.Phase="Waiting" self.Remotes.State:FireAllClients("Notice","Runde zurückgesetzt. Eine neue Runde startet gleich.") task.wait(3)
            end
        end
    end)
end
return Round
</ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX1385">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CharacterWalkSpeed">16.0</float>
      <float name="CharacterJumpPower">50.0</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX1386">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX1387">
        <Properties>
          <string name="Name">Effects</string>
          <ProtectedString name="Source">local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local Run=game:GetService("RunService")
local Tween=game:GetService("TweenService")
local Debris=game:GetService("Debris")
local SoundService=game:GetService("SoundService")
local Config=require(RS.Shared.Config)
local Catalog=require(RS.Shared.Catalog)
local Effects={Settings={Music=true,Effects=true,ReducedMotion=false,Quality="High"},Pets={},Emotes={}}
local player=Players.LocalPlayer
local localFolder=Instance.new("Folder") localFolder.Name="NeroLocalVisuals" localFolder.Parent=workspace
local music=Instance.new("Sound") music.Name="NeroMusic" music.SoundId=Config.Audio.Music music.Volume=.18 music.Looped=true music.Parent=SoundService
local musicPlaying=false
function Effects.Sound(name,pos)
    if not Effects.Settings.Effects then return end
    local id=Config.Audio[name] if not id or id=="" then return end
    local sound=Instance.new("Sound") sound.SoundId=id sound.Volume=.4 sound.RollOffMaxDistance=100
    if pos then
        local anchor=Instance.new("Part") anchor.Anchored=true anchor.CanCollide=false anchor.CanTouch=false anchor.CanQuery=false anchor.Transparency=1 anchor.Size=Vector3.one*.1 anchor.Position=pos anchor.Parent=localFolder
        sound.Parent=anchor Debris:AddItem(anchor,5)
    else sound.Parent=SoundService Debris:AddItem(sound,5) end
    sound:Play()
end
function Effects.Music(active)
    musicPlaying=active
    if active and Effects.Settings.Music and Config.Audio.Music~="" then if not music.IsPlaying then music:Play() end music.Volume=.18 else music:Stop() end
end
function Effects.Configure(settings) Effects.Settings=settings Effects.Music(musicPlaying) end
local function particles(pos,color,count)
    if not Effects.Settings.Effects then return end
    local anchor=Instance.new("Part") anchor.Anchored=true anchor.CanCollide=false anchor.CanTouch=false anchor.CanQuery=false anchor.Transparency=1 anchor.Size=Vector3.one*.1 anchor.Position=pos anchor.Parent=localFolder
    local emitter=Instance.new("ParticleEmitter") emitter.Texture="rbxasset://textures/particles/sparkles_main.dds" emitter.Color=ColorSequence.new(color or Color3.fromRGB(255,160,220))
    emitter.Lifetime=NumberRange.new(.5,1.2) emitter.Speed=NumberRange.new(8,18) emitter.SpreadAngle=Vector2.new(180,180) emitter.Acceleration=Vector3.new(0,-20,0)
    emitter.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,.6),NumberSequenceKeypoint.new(1,0)}) emitter.Rate=0 emitter.Parent=anchor
    emitter:Emit(if Effects.Settings.Quality=="Low" then math.min(count,8) else count) Debris:AddItem(anchor,2)
end
local function bubble(pos,color)
    if not Effects.Settings.Effects then return end
    local p=Instance.new("Part") p.Anchored=true p.CanCollide=false p.CanTouch=false p.CanQuery=false p.Shape=Enum.PartType.Ball p.Material=Enum.Material.Neon
    p.Size=Vector3.one p.Color=color or Color3.fromRGB(115,225,255) p.Transparency=.4 p.Position=pos p.Parent=localFolder
    Tween:Create(p,TweenInfo.new(.5),{Size=Vector3.one*9,Transparency=1}):Play() Debris:AddItem(p,.6)
end
local function stopEmote(id)
    local animation=Effects.Emotes[id] if not animation then return end
    for motor,c0 in animation.Joints do if motor.Parent then motor.C0=c0 end end
    Effects.Emotes[id]=nil
end
function Effects.Emote(id,name)
    local p=Players:GetPlayerByUserId(id) local c=p and p.Character if not c then return end
    stopEmote(id)
    local joints={}
    for _,v in c:GetDescendants() do if v:IsA("Motor6D") then joints[v]=v.C0 end end
    Effects.Emotes[id]={Character=c,Name=name,Start=os.clock(),Joints=joints}
end
local targetMarker
function Effects.Target(pos)
    if targetMarker then targetMarker:Destroy() targetMarker=nil end
    if typeof(pos)~="Vector3" then return end
    local p=Instance.new("Part") p.Anchored=true p.CanCollide=false p.CanTouch=false p.CanQuery=false p.Transparency=1 p.Size=Vector3.one p.Position=pos p.Parent=localFolder targetMarker=p
    local g=Instance.new("BillboardGui") g.Size=UDim2.fromOffset(100,50) g.AlwaysOnTop=true g.StudsOffset=Vector3.new(0,6,0) g.Parent=p
    local text=Instance.new("TextLabel") text.Size=UDim2.fromScale(1,1) text.BackgroundTransparency=1 text.Text="▼ DEIN RING" text.TextColor3=Color3.fromRGB(255,225,75) text.Font=Enum.Font.GothamBold text.TextSize=16 text.Parent=g
end
function Effects.Handle(name,a,b)
    if name=="Emote" then Effects.Emote(a,b) return end
    if name=="ItemSwing" then Effects.Emote(a,"ItemSwing") return end
    if name=="Photo" then
        if Effects.Settings.ReducedMotion then return end
        local camera=workspace.CurrentCamera local c=player.Character local r=c and c:FindFirstChild("HumanoidRootPart")
        if not r then return end
        camera.CameraType=Enum.CameraType.Scriptable
        camera.CFrame=CFrame.lookAt(r.Position+Vector3.new(0,3,-12),r.Position+Vector3.new(0,1,0))
        task.delay(4,function() camera.CameraType=Enum.CameraType.Custom end) return
    end
    if typeof(a)~="Vector3" then return end
    if name=="Confetti" then particles(a,b,30)
    elseif name=="Water" or name=="Bubble" then bubble(a,Color3.fromRGB(100,215,255))
    elseif name=="Rocket" then particles(a,Color3.fromRGB(255,185,65),24) Effects.Sound("Horn",a)
    elseif name=="Push" then bubble(a,Color3.fromRGB(215,160,255))
    else Effects.Sound(name,a) if name=="Victory" or name=="Explosion" then particles(a,b,20) end end
end
local accumulator=0
Run.RenderStepped:Connect(function(dt)
    accumulator+=dt
    local time=os.clock()
    -- Cosmetic pets render locally for every player; never participate in physics or scores.
    if accumulator&gt;(if Effects.Settings.Quality=="Low" then .08 else .03) then
        accumulator=0
        for _,p in Players:GetPlayers() do
            local product=Catalog.ById[p:GetAttribute("EquippedPets")]
            local c=p.Character local root=c and c:FindFirstChild("HumanoidRootPart") local pet=Effects.Pets[p]
            if pet and (not product or pet.Id~=product.Id or not root) then pet.Model:Destroy() Effects.Pets[p]=nil pet=nil end
            if product and root then
                if not pet then
                    local m=RS.Assets[product.Model]:Clone() m:ScaleTo(.6) m.Parent=localFolder
                    pet={Model=m,Id=product.Id} Effects.Pets[p]=pet m:PivotTo(root.CFrame*CFrame.new(3,-.6,3))
                end
                local desired=root.CFrame*CFrame.new(3,-.5+math.sin(time*3+p.UserId)*.35,3)
                pet.Model:PivotTo(pet.Model:GetPivot():Lerp(desired,.22))
            end
        end
        for p,pet in Effects.Pets do if not p.Parent then pet.Model:Destroy() Effects.Pets[p]=nil end end
        if musicPlaying and Effects.Settings.Music and Config.Audio.Music=="" and math.floor(time*2)~=Effects.LastBeat then
            Effects.LastBeat=math.floor(time*2)
            local sound=Instance.new("Sound") sound.SoundId=Config.Audio.Countdown sound.Volume=.13 sound.PlaybackSpeed=({1,1.25,1.5,1.25})[Effects.LastBeat%4+1] sound.Parent=SoundService sound:Play() Debris:AddItem(sound,2)
        end
    end
    for id,animation in Effects.Emotes do
        local c=animation.Character local h=c:FindFirstChildOfClass("Humanoid") local t=time-animation.Start
        if not c.Parent or not h or h.Health&lt;=0 or h.MoveDirection.Magnitude&gt;.1 or c:GetAttribute("Ragdolled") or t&gt;(if animation.Name=="ItemSwing" then .8 else 5) then stopEmote(id)
        else
            local name=animation.Name local wave=math.sin(t*7)
            for joint,original in animation.Joints do
                if joint.Parent then
                    local n=joint.Name local transform=CFrame.identity
                    if n:find("Shoulder") then
                        local sign=if n:find("Right") then 1 else -1
                        if name=="Cry" then transform=CFrame.Angles(-1.5,0,sign*.4)
                        elseif name=="RobotDance" then transform=CFrame.Angles(math.floor(wave*2)*.4,0,sign*1.1)
                        elseif name=="VictoryPose" then transform=CFrame.Angles(0,0,sign*2.3)
                        elseif name=="ItemSwing" then transform=CFrame.Angles(-math.sin(t*math.pi/.8)*1.8,0,0)
                        else transform=CFrame.Angles(wave*.7,0,sign*(.9+wave*.3)) end
                    elseif n=="RootJoint" or n=="Root" or n=="Waist" then
                        if name=="Spin" then transform=CFrame.Angles(0,t*4,0)
                        elseif name=="Backflip" then transform=CFrame.new(0,math.sin(t*math.pi%math.pi)*1.2,0)*CFrame.Angles(-t*math.pi*2,0,0)
                        elseif name=="CrazyJump" then transform=CFrame.new(0,math.abs(wave)*1.5,0)
                        elseif name=="ChickenDance" then transform=CFrame.Angles(wave*.2,0,0)
                        elseif name=="BananaDance" then transform=CFrame.Angles(0,0,wave*.3)
                        elseif name=="Laugh" then transform=CFrame.Angles(.2+wave*.1,0,0)
                        else transform=CFrame.Angles(0,wave*.15,wave*.1) end
                    elseif n=="Neck" then transform=CFrame.Angles(wave*.1,0,0) end
                    joint.C0=original*transform
                end
            end
        end
    end
end)
Run:BindToRenderStep("NeroCamera",Enum.RenderPriority.Camera.Value+1,function()
    if player:GetAttribute("ChaosCamera") and not Effects.Settings.ReducedMotion then workspace.CurrentCamera.CFrame*=CFrame.Angles(0,0,math.sin(os.clock()*5)*.035) end
end)
local function watch(p)
    local function character(c)
        c:GetAttributeChangedSignal("Ragdolled"):Connect(function()
            if c:GetAttribute("Ragdolled") and p:GetAttribute("EquippedRagdoll")=="Stars" then local r=c:FindFirstChild("HumanoidRootPart") if r then particles(r.Position,Color3.fromRGB(255,225,80),18) end end
        end)
    end
    p.CharacterAdded:Connect(character)
    if p.Character then character(p.Character) end
end
Players.PlayerAdded:Connect(watch) for _,p in Players:GetPlayers() do watch(p) end
return Effects
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX1388">
        <Properties>
          <string name="Name">InterfaceRoot</string>
          <ProtectedString name="Source">local InterfaceRoot={}

function InterfaceRoot.Create(playerGui)
    -- StarterGui may be cloned after StarterPlayerScripts starts, or on respawn.
    -- Keep the world visible even when updating scripts in an older place file.
    local previous=playerGui:FindFirstChild("NeroInterface")
    if previous and previous:IsA("ScreenGui") then previous:Destroy() end

    local gui=Instance.new("ScreenGui")
    gui.Name="NeroInterface"
    gui.ResetOnSpawn=false
    gui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder=10

    local function removeLegacyLoading(child)
        if child.Name=="Loading" and child:IsA("ScreenGui") then
            child.Enabled=false
            child:Destroy()
        end
    end

    -- Subscribe before scanning: neither existing nor later copies can be missed.
    local added=playerGui.ChildAdded:Connect(removeLegacyLoading)
    gui.Destroying:Connect(function() added:Disconnect() end)
    for _,child in playerGui:GetChildren() do removeLegacyLoading(child) end
    gui.Parent=playerGui
    return gui
end

return InterfaceRoot
</ProtectedString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBX1389">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source">local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local Tween=game:GetService("TweenService")
local CAS=game:GetService("ContextActionService")
local UIS=game:GetService("UserInputService")
local GuiService=game:GetService("GuiService")
local Social=game:GetService("SocialService")
local Run=game:GetService("RunService")
local player=Players.LocalPlayer
local InterfaceRoot=require(script.Parent:WaitForChild("InterfaceRoot"))
local gui=InterfaceRoot.Create(player:WaitForChild("PlayerGui"))
local Shared=RS:WaitForChild("Shared")
local Catalog=require(Shared.Catalog)
local Rules=require(Shared.Rules)
local Config=require(Shared.Config)
local Effects=require(script.Parent.Effects)
local remotes=RS:WaitForChild("Remotes")
local request,state=remotes:WaitForChild("Request"),remotes:WaitForChild("State")
local profile=Rules.NewProfile() local sessionOnly=false local isOwner=false local lastLevel=1
local round={} local party={Members={}} local invitation=nil local current=nil local selected=nil local shopCategory="Alle"
local voteButtons={} local noticeSerial=0 local musicActive=false
local palette={Background=Color3.fromRGB(22,25,46),Panel=Color3.fromRGB(36,41,68),Card=Color3.fromRGB(53,59,90),Accent=Color3.fromRGB(122,101,255),Pink=Color3.fromRGB(255,112,170),Gold=Color3.fromRGB(255,218,94),Mint=Color3.fromRGB(100,235,195),Text=Color3.fromRGB(246,247,255),Muted=Color3.fromRGB(190,197,220)}
local function make(class,props,parent)
    local obj=Instance.new(class) for k,v in props do obj[k]=v end obj.Parent=parent return obj
end
local function roundCorners(obj,radius) make("UICorner",{CornerRadius=UDim.new(0,radius or 12)},obj) end
local function stroke(obj,color) make("UIStroke",{Color=color or Color3.fromRGB(77,84,122),Thickness=1,Transparency=.25},obj) end
local function text(parent,message,size,color)
    return make("TextLabel",{Text=message,Font=Enum.Font.GothamMedium,TextSize=size or 16,TextColor3=color or palette.Text,BackgroundTransparency=1,TextWrapped=true,TextXAlignment=Enum.TextXAlignment.Left,Size=UDim2.new(1,0,0,40)},parent)
end
local function button(parent,title,callback,color)
    local b=make("TextButton",{Text=title,Font=Enum.Font.GothamBold,TextSize=15,TextColor3=palette.Text,BackgroundColor3=color or palette.Accent,AutoButtonColor=false,Size=UDim2.new(1,0,0,48),Selectable=true},parent)
    roundCorners(b,10)
    b.Activated:Connect(function() Effects.Sound("Countdown") callback() end)
    b.MouseEnter:Connect(function() Tween:Create(b,TweenInfo.new(.12),{BackgroundTransparency=.18}):Play() end)
    b.MouseLeave:Connect(function() Tween:Create(b,TweenInfo.new(.12),{BackgroundTransparency=0}):Play() end)
    return b
end
local function list(parent,padding,horizontal)
    return make("UIListLayout",{Padding=UDim.new(0,padding or 10),SortOrder=Enum.SortOrder.LayoutOrder,FillDirection=if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical},parent)
end
local function pad(parent,size) make("UIPadding",{PaddingLeft=UDim.new(0,size),PaddingRight=UDim.new(0,size),PaddingTop=UDim.new(0,size),PaddingBottom=UDim.new(0,size)},parent) end
local hud=make("Frame",{Name="HUD",AnchorPoint=Vector2.new(.5,0),Position=UDim2.new(.5,0,0,8),Size=UDim2.new(.94,0,0,112),BackgroundColor3=palette.Background,BackgroundTransparency=.08},gui)
make("UISizeConstraint",{MaxSize=Vector2.new(850,112)},hud) roundCorners(hud,16) stroke(hud) pad(hud,12)
local brand=text(hud,"NERO  /  CHAOS PARTY",17,palette.Pink) brand.Size=UDim2.new(.62,0,0,24)
local timer=text(hud,"00:00",23,palette.Gold) timer.Size=UDim2.new(.3,0,0,28) timer.Position=UDim2.new(.7,0,0,0) timer.TextXAlignment=Enum.TextXAlignment.Right
local phase=text(hud,"Willkommen auf der Party!",16) phase.Position=UDim2.fromOffset(0,31) phase.Size=UDim2.new(1,0,0,26)
local stats=text(hud,"CHAOS COINS 0  ·  WINS 0  ·  LVL 1",13,palette.Muted) stats.Position=UDim2.fromOffset(0,64) stats.Size=UDim2.new(1,0,0,24)
local toast=make("TextLabel",{AnchorPoint=Vector2.new(.5,0),Position=UDim2.new(.5,0,0,128),Size=UDim2.new(.9,0,0,48),BackgroundColor3=palette.Panel,BackgroundTransparency=.06,Text="",TextColor3=palette.Text,Font=Enum.Font.GothamBold,TextSize=16,TextWrapped=true,Visible=false},gui)
make("UISizeConstraint",{MaxSize=Vector2.new(820,70)},toast) roundCorners(toast)
local function notify(message)
    noticeSerial+=1 local token=noticeSerial toast.Text=message toast.Visible=true
    task.delay(5,function() if token==noticeSerial then toast.Visible=false end end)
end
local menu=make("ScrollingFrame",{Name="Menu",AnchorPoint=Vector2.new(.5,1),Position=UDim2.new(.5,0,1,-8),Size=UDim2.new(.96,0,0,62),BackgroundColor3=palette.Background,BackgroundTransparency=.08,BorderSizePixel=0,CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.X,ScrollBarThickness=2,ScrollingDirection=Enum.ScrollingDirection.X},gui)
roundCorners(menu) pad(menu,7) list(menu,8,true) make("UISizeConstraint",{MaxSize=Vector2.new(1020,62)},menu)
local overlay=make("Frame",{Name="Window",AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.52),Size=UDim2.new(.94,0,.72,0),BackgroundColor3=palette.Background,Visible=false,ZIndex=5},gui)
make("UISizeConstraint",{MaxSize=Vector2.new(780,580),MinSize=Vector2.new(260,220)},overlay) roundCorners(overlay,18) stroke(overlay,palette.Accent)
local heading=text(overlay,"PARTY",23) heading.Position=UDim2.fromOffset(18,8) heading.Size=UDim2.new(1,-85,0,44)
local close=button(overlay,"×",function() overlay.Visible=false current=nil GuiService.SelectedObject=nil end,palette.Card) close.Size=UDim2.fromOffset(44,44) close.Position=UDim2.new(1,-52,0,8)
local body=make("ScrollingFrame",{Position=UDim2.fromOffset(0,62),Size=UDim2.new(1,0,1,-70),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=5,ScrollBarImageColor3=palette.Accent,AutomaticCanvasSize=Enum.AutomaticSize.Y,CanvasSize=UDim2.new()},overlay)
pad(body,14) list(body,10)
local function clear()
    for _,child in body:GetChildren() do if child:IsA("GuiObject") then child:Destroy() end end
    body.CanvasPosition=Vector2.zero voteButtons={}
end
local function info(message,height)
    local t=text(body,message,15,palette.Muted) t.Size=UDim2.new(1,-8,0,height or 54) return t
end
local function row(title,subtitle,callback,buttonLabel)
    local frame=make("Frame",{Size=UDim2.new(1,-8,0,82),BackgroundColor3=palette.Card},body) roundCorners(frame)
    local label=text(frame,title,16) label.Position=UDim2.fromOffset(12,8) label.Size=UDim2.new(1,-125,0,30)
    local sub=text(frame,subtitle or "",12,palette.Muted) sub.Position=UDim2.fromOffset(12,40) sub.Size=UDim2.new(1,-125,0,30)
    if callback then local b=button(frame,buttonLabel or "Öffnen",callback) b.Size=UDim2.fromOffset(105,52) b.AnchorPoint=Vector2.new(1,.5) b.Position=UDim2.new(1,-10,.5,0) return b end
    label.Size=UDim2.new(1,-24,0,30) sub.Size=UDim2.new(1,-24,0,30)
end
local open
local function preview(product)
    local view=make("ViewportFrame",{Size=UDim2.new(1,-8,0,185),BackgroundColor3=palette.Panel,Ambient=Color3.fromRGB(180,180,200),LightColor=Color3.new(1,1,1),LightDirection=Vector3.new(-1,-1,-1)},body) roundCorners(view)
    local world=Instance.new("WorldModel") world.Parent=view
    local model
    if product.Model and RS.Assets:FindFirstChild(product.Model) then model=RS.Assets[product.Model]:Clone()
    else
        model=Instance.new("Model")
        local p=Instance.new("Part") p.Shape=Enum.PartType.Ball p.Size=Vector3.one*3 p.Material=Enum.Material.Neon
        local c=product.Color or {160,120,255} p.Color=Color3.fromRGB(c[1],c[2],c[3]) p.Anchored=true p.Parent=model
        if product.Category=="Emotes" then p:Destroy() model=RS.Assets.Robot:Clone() end
    end
    model.Parent=world model:PivotTo(CFrame.new())
    local camera=Instance.new("Camera") camera.CFrame=CFrame.lookAt(Vector3.new(5,3.5,-7),Vector3.new(0,.5,0)) camera.Parent=view view.CurrentCamera=camera
    local conn
    conn=Run.RenderStepped:Connect(function(dt)
        if not view.Parent then conn:Disconnect() return end
        if not profile.Settings.ReducedMotion then model:PivotTo(model:GetPivot()*CFrame.Angles(0,dt*.6,0)) end
    end)
end
local titles={Shop="CHAOS SHOP",Pets="PET CLUB",Rewards="REWARDS",Profile="DEIN PROFIL",Settings="EINSTELLUNGEN",Emotes="EMOTE WHEEL",Party="FREUNDE &amp; PARTY",Items="FUNNY ITEMS",Voting="DEINE STIMME ZÄHLT",Admin="OWNER PANEL",Detail="VORSCHAU"}
local function render()
    clear() heading.Text=titles[current] or "NERO CHAOS PARTY"
    if current=="Shop" or current=="Pets" then
        info(if current=="Pets" then "Deine Begleiter sind kosmetisch. Ausrüsten, sammeln und Favoriten markieren." else "Alle Preise in erspielten Chaos Coins. Vorschau öffnen, kaufen und ausrüsten.",52)
        if current=="Shop" then
            local filters=make("ScrollingFrame",{Size=UDim2.new(1,-8,0,52),BackgroundTransparency=1,BorderSizePixel=0,AutomaticCanvasSize=Enum.AutomaticSize.X,CanvasSize=UDim2.new(),ScrollBarThickness=2},body) list(filters,6,true)
            for _,category in {"Alle","Trails","Hats","Wings","Costumes","Auras","Ragdoll","Victory","Emotes"} do
                local b=button(filters,category,function() shopCategory=category render() end,if shopCategory==category then palette.Accent else palette.Card) b.Size=UDim2.fromOffset(110,46)
            end
        end
        local products=table.clone(Catalog.Products)
        table.sort(products,function(a,b)
            local af,bf=profile.Favorites[a.Id] or false,profile.Favorites[b.Id] or false
            if af~=bf then return af end return a.Price&lt;b.Price or (a.Price==b.Price and a.Id&lt;b.Id)
        end)
        for _,p in products do
            if (current=="Pets" and p.Category=="Pets") or (current=="Shop" and p.Category~="Pets" and (shopCategory=="Alle" or p.Category==shopCategory)) then
                row((if profile.Favorites[p.Id] then "★ " else "")..p.Name,p.Category.." · "..(if profile.Owned[p.Id] then "In deiner Sammlung" else tostring(p.Price).." Coins"),function() selected=p.Id open("Detail") end,"Vorschau")
            end
        end
    elseif current=="Detail" then
        local p=Catalog.ById[selected] if not p then return end
        heading.Text=p.Name preview(p)
        info(p.Category.." · "..(if profile.Owned[p.Id] then "Gehört dir" else p.Price.." Chaos Coins"),32)
        if not profile.Owned[p.Id] then button(body,"KAUFEN · "..p.Price.." COINS",function() request:FireServer("Buy",p.Id) end)
        elseif p.Category=="Emotes" then button(body,"EMOTE SPIELEN",function() request:FireServer("Emote",p.Id) end)
        else button(body,if profile.Equipped[p.Category]==p.Id then "ABLEGEN" else "AUSRÜSTEN",function() request:FireServer("Equip",p.Id) end) end
        if p.Category=="Pets" and profile.Owned[p.Id] then button(body,if profile.Favorites[p.Id] then "★ FAVORIT ENTFERNEN" else "☆ ALS FAVORIT MARKIEREN",function() request:FireServer("Favorite",p.Id) end,palette.Card) end
        button(body,"ZURÜCK",function() open(if p.Category=="Pets" then "Pets" else "Shop") end,palette.Card)
    elseif current=="Items" then
        info("Kostenlose Party-Requisiten für die Lobby. In gewerteten Minispielen sind Items gesperrt; Sumo hat seinen eigenen Schubs.",64)
        for _,item in Catalog.Items do
            row(item.Name,item.Cooldown.."s Cooldown · "..(if player:GetAttribute("PartyItem")==item.Id then "Ausgewählt" else "Gratis"),function() selected=item.Id open("ItemDetail") end,"Vorschau")
        end
    elseif current=="ItemDetail" then
        local item=Catalog.ItemById[selected] if not item then return end heading.Text=item.Name preview(item)
        info(item.Cooldown.." Sekunden Cooldown · Verwendung in der Lobby",38)
        button(body,"ITEM AUSWÄHLEN",function() request:FireServer("SelectItem",item.Id) end)
        button(body,"BENUTZEN",function() request:FireServer("UseItem") end,palette.Pink)
        button(body,"ZURÜCK ZU ITEMS",function() open("Items") end,palette.Card)
    elseif current=="Rewards" then
        local day=Rules.Day(os.time())
        info("Kostenloses Glücksrad und tägliche Geschenke. Tageswechsel: 00:00 UTC. Keine Robux-Einsätze.",52)
        row("DAILY REWARD", "Serie: "..profile.DailyStreak.." / 7 · Tag 7: Krone (bei Besitz 150 Coins)",function() request:FireServer("Daily") end,if profile.DailyDay&gt;=day then "Abgeholt" else "Abholen")
        local wheel=make("Frame",{Size=UDim2.new(1,-8,0,160),BackgroundColor3=palette.Panel},body) roundCorners(wheel)
        local disc=make("Frame",{Name="Disc",AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.fromOffset(138,138),BackgroundColor3=palette.Accent},wheel) roundCorners(disc,100)
        for i=1,8 do
            local a=i*math.pi/4
            local dot=make("Frame",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.new(.5,math.cos(a)*51,.5,math.sin(a)*51),Size=UDim2.fromOffset(20,20),BackgroundColor3=Color3.fromHSV(i/8,.55,1)},disc) roundCorners(dot,10)
        end
        local center=text(disc,"NERO\nSPIN",19) center.TextXAlignment=Enum.TextXAlignment.Center center.Size=UDim2.fromScale(1,1)
        button(body,if profile.SpinDay&gt;=day then "HEUTE SCHON GEDREHT" else "KOSTENLOS DREHEN",function() request:FireServer("Spin") end,palette.Accent)
        info("Chancen: 25 Coins 45% · 50 Coins 30% · Rainbow Trail 10% · Spin-Emote 8% · Duck Pet 7%. Doppelte Cosmetics ergeben 75 Coins.",68)
        for _,q in Catalog.Quests do row(q.Name,math.min(q.Goal,profile[q.Field]).." / "..q.Goal.." · "..q.Coins.." Coins",function() request:FireServer("Quest",q.Id) end,if profile.QuestClaims[q.Id] then "Erledigt" else "Abholen") end
    elseif current=="Profile" then
        local level=Rules.Level(profile.XP) local nextXP=Rules.LevelXP(level+1)
        info(player.DisplayName.."  ·  LEVEL "..level.."  ·  "..profile.XP.." / "..nextXP.." XP",40)
        local track=make("Frame",{Size=UDim2.new(1,-8,0,18),BackgroundColor3=palette.Card},body) roundCorners(track,9)
        local progress=(profile.XP-Rules.LevelXP(level))/(nextXP-Rules.LevelXP(level))
        local fill=make("Frame",{Size=UDim2.fromScale(math.clamp(progress,0,1),1),BackgroundColor3=palette.Mint},track) roundCorners(fill,9)
        local pets,cosmetics=0,0 for id in profile.Owned do local p=Catalog.ById[id] if p then if p.Category=="Pets" then pets+=1 else cosmetics+=1 end end end
        for _,v in {{"CHAOS COINS",profile.Coins},{"WINS / GAMES WON",profile.Wins},{"GAMES PLAYED",profile.GamesPlayed},{"ÜBERLEBT",profile.Survived},{"SPIELZEIT",math.floor(profile.Playtime/60).." Minuten"},{"SAMMLUNG",pets.." Pets · "..cosmetics.." Cosmetics"}} do row(v[1],tostring(v[2])) end
        for _,a in Catalog.Achievements do row(a.Name,if profile.Achievements[a.Id] then "✓ Freigeschaltet · "..a.Coins.." Bonus-Coins" else tostring(profile[a.Field]).." / "..a.Goal) end
        info("Level-Boni: 5 → 100 Coins · 10 → Rainbow Trail · 20 → Victory Pose · 30 → Dragon Pet · 50 → Disco Aura",60)
        if sessionOnly then info("STUDIO-TEST: Diese Sitzung wird nicht dauerhaft gespeichert. Siehe Installationsanleitung für DataStore-Tests.",68) end
    elseif current=="Settings" then
        for _,setting in {{"Music","Musik"},{"Effects","Sound &amp; Effekte"},{"ReducedMotion","Weniger Bewegung"}} do
            row(setting[2],if profile.Settings[setting[1]] then "An" else "Aus",function() request:FireServer("Settings",{Key=setting[1],Value=not profile.Settings[setting[1]]}) end,"Umschalten")
        end
        row("Grafikqualität",profile.Settings.Quality,function() request:FireServer("Settings",{Key="Quality",Value=if profile.Settings.Quality=="High" then "Low" else "High"}) end,"Umschalten")
        row("AFK",if player:GetAttribute("AFK") then "Du setzt aus" else "Du spielst mit",function() request:FireServer("AFK") task.delay(.3,render) end,"Umschalten")
        info("PC: E schubsen · Q Item · B Emotes · M Menü. Gamepad: X Aktion · R2 Item · Y Emotes. Mobile: Standard-Joystick + Sprung, zusätzliche Buttons rechts.",90)
    elseif current=="Emotes" then
        info("Emotes spielen in der Lobby. Bewegung beendet sie. Gesperrte Emotes öffnen den Shop.",48)
        local wheel=make("Frame",{Size=UDim2.new(1,-8,0,330),BackgroundTransparency=1},body)
        local emotes={} for _,p in Catalog.Products do if p.Category=="Emotes" then table.insert(emotes,p) end end
        for i,p in emotes do
            local a=(i-1)/#emotes*math.pi*2-math.pi/2
            local b=button(wheel,(if profile.Owned[p.Id] then "" else "🔒 ")..p.Name,function()
                if profile.Owned[p.Id] then request:FireServer("Emote",p.Id) overlay.Visible=false current=nil else selected=p.Id open("Detail") end
            end,if profile.Owned[p.Id] then palette.Accent else palette.Card)
            b.AnchorPoint=Vector2.new(.5,.5) b.Position=UDim2.new(.5+math.cos(a)*.34,0,.5+math.sin(a)*.4,0) b.Size=UDim2.new(.29,0,0,48) b.TextSize=12
        end
    elseif current=="Party" then
        info("Alle aktiven Spieler dieses Servers spielen dieselben Runden. Freunde können über Roblox beitreten; private Server werden unterstützt.",70)
        button(body,"ROBLOX-FREUNDE EINLADEN",function()
            local ok,can=pcall(Social.CanSendGameInviteAsync,Social,player)
            if ok and can then local worked=pcall(Social.PromptGameInvite,Social,player) if not worked then notify("Einladen ist hier gerade nicht verfügbar.") end
            else notify("Roblox-Einladungen sind in dieser Sitzung nicht verfügbar (z. B. Studio).") end
        end)
        if invitation then row("Einladung von "..invitation.Name,"30 Sekunden gültig",function() request:FireServer("AcceptParty",invitation.Id) invitation=nil end,"Annehmen") end
        for _,member in party.Members do row(member.Name,if party.Leader==member.Id then "Gruppenleiter" else "Party-Mitglied") end
        button(body,"GRUPPE VERLASSEN",function() request:FireServer("LeaveParty") end,palette.Card)
        for _,p in Players:GetPlayers() do if p~=player then row(p.DisplayName,"Auf diesem Server",function() request:FireServer("InviteParty",p.UserId) end,"Einladen") end end
    elseif current=="Voting" then
        info("Drei Spiele stehen zur Wahl. Du kannst deine Stimme bis zum Countdown-Ende ändern.",52)
        for _,id in round.Choices or {} do
            local gameInfo=Catalog.GameById[id]
            if gameInfo then voteButtons[id]=row(gameInfo.Name,gameInfo.Rules,function() request:FireServer("Vote",id) end,tostring((round.Votes or {})[id] or 0).." Stimmen") end
        end
    elseif current=="Admin" and isOwner then
        info("Servergeprüfte Owner-Aktionen. Test-Coins/Wins ändern echte Profile; Beträge können negativ sein. Maximal ±10.000 pro Aktion.",72)
        button(body,"RUNDE / COUNTDOWN STARTEN",function() request:FireServer("Admin",{Action="Start"}) end)
        button(body,"RUNDE OHNE WERTUNG BEENDEN",function() request:FireServer("Admin",{Action="End"}) end,palette.Pink)
        button(body,"SERVERSTATUS",function() request:FireServer("Admin",{Action="Status"}) end,palette.Card)
        local target=make("TextBox",{Size=UDim2.new(1,-8,0,48),Text=tostring(player.UserId),PlaceholderText="Roblox UserId des Zielspielers",ClearTextOnFocus=false,TextColor3=palette.Text,TextSize=16,BackgroundColor3=palette.Card,Font=Enum.Font.Gotham},body) roundCorners(target)
        local amount=make("TextBox",{Size=UDim2.new(1,-8,0,48),Text="100",PlaceholderText="Betrag",ClearTextOnFocus=false,TextColor3=palette.Text,TextSize=16,BackgroundColor3=palette.Card,Font=Enum.Font.Gotham},body) roundCorners(amount)
        for _,action in {"Coins","Wins","Teleport","Kick"} do button(body,action,function() request:FireServer("Admin",{Action=action,UserId=tonumber(target.Text),Amount=tonumber(amount.Text)}) end,palette.Card) end
        info("NÄCHSTES MINISPIEL",30)
        for _,g in Catalog.Games do button(body,g.Name,function() request:FireServer("Admin",{Action="SelectGame",Id=g.Id}) end,palette.Card) end
        info("CHAOS-EVENT IN AKTIVER RUNDE",30)
        for _,e in Catalog.Events do button(body,e.Name,function() request:FireServer("Admin",{Action="Event",Id=e.Id}) end,palette.Card) end
    end
end
open=function(name)
    current=name overlay.Visible=true render()
    if UIS.GamepadEnabled then GuiService.SelectedObject=close end
end
for _,entry in {{"▶ PLAY","Play"},{"PETS","Pets"},{"SHOP","Shop"},{"EMOTES","Emotes"},{"REWARDS","Rewards"},{"PROFILE","Profile"},{"ITEMS","Items"},{"PARTY","Party"},{"⚙","Settings"}} do
    local b=button(menu,entry[1],function() if entry[2]=="Play" then request:FireServer("Play") overlay.Visible=false current=nil else open(entry[2]) end end,if entry[2]=="Play" then palette.Accent else palette.Card)
    b.Size=UDim2.fromOffset(if entry[2]=="Settings" then 52 else 100,48)
end
local actionButton=button(gui,"SCHUBS",function() request:FireServer("Push") end,palette.Pink)
actionButton.AnchorPoint=Vector2.new(1,1) actionButton.Position=UDim2.new(1,-110,1,-95) actionButton.Size=UDim2.fromOffset(88,56)
local itemButton=button(gui,"ITEM",function() request:FireServer("UseItem") end,palette.Accent)
itemButton.AnchorPoint=Vector2.new(1,1) itemButton.Position=UDim2.new(1,-16,1,-190) itemButton.Size=UDim2.fromOffset(80,56)
local function bind(name,keys,callback)
    CAS:BindAction(name,function(_,inputState) if inputState==Enum.UserInputState.Begin and not UIS:GetFocusedTextBox() then callback() end return Enum.ContextActionResult.Pass end,false,table.unpack(keys))
end
bind("NeroPush",{Enum.KeyCode.E,Enum.KeyCode.ButtonX},function() request:FireServer("Push") end)
bind("NeroItem",{Enum.KeyCode.Q,Enum.KeyCode.ButtonR2},function() request:FireServer("UseItem") end)
bind("NeroEmotes",{Enum.KeyCode.B,Enum.KeyCode.ButtonY},function() open("Emotes") end)
bind("NeroMenu",{Enum.KeyCode.M},function() open("Settings") end)
UIS.JumpRequest:Connect(function() if player:GetAttribute("DoubleJump") then request:FireServer("DoubleJump") end end)
task.spawn(function()
    local module=player.PlayerScripts:WaitForChild("PlayerModule",15)
    if not module then return end
    local ok,controls=pcall(function() return require(module):GetControls() end)
    if not ok then return end
    Run:BindToRenderStep("NeroReverse",Enum.RenderPriority.Input.Value+1,function()
        if player:GetAttribute("Reverse") then
            local h=player.Character and player.Character:FindFirstChildOfClass("Humanoid")
            if h then h:Move(-controls:GetMoveVector(),true) end
        end
    end)
end)
state.OnClientEvent:Connect(function(kind,payload)
    if kind=="Profile" then
        profile=payload.Data sessionOnly=payload.SessionOnly
        local level=Rules.Level(profile.XP)
        stats.Text=string.format("COINS %d  ·  WINS %d  ·  LVL %d%s",profile.Coins,profile.Wins,level,if sessionOnly then " · STUDIO" else "")
        if level&gt;lastLevel then notify("LEVEL UP! Du bist jetzt Level "..level) Effects.Sound("LevelUp") end lastLevel=level
        Effects.Configure(profile.Settings)
        if current and current~="Voting" and current~="Admin" then render() end
    elseif kind=="Round" then
        local oldPhase=round.Phase round=payload
        if round.Game~="Music" then Effects.Music(round.Phase~="Playing") end
        local seconds=round.Seconds or 0 timer.Text=string.format("%02d:%02d",math.floor(seconds/60),seconds%60)
        local g=Catalog.GameById[round.Game]
        phase.Text=(if g then g.Name else ({Waiting="WARTE AUF SPIELER",Intermission="NÄCHSTE RUNDE",Voting="ABSTIMMUNG",Results="ERGEBNIS"})[round.Phase] or "PARTY").." · "..tostring(round.Alive or 0).." aktiv"
        actionButton.Visible=round.Game=="Sumo" and player:GetAttribute("InRound")==true
        itemButton.Visible=not player:GetAttribute("InRound")
        if round.Phase=="Voting" and oldPhase~="Voting" then open("Voting")
        elseif oldPhase=="Voting" and round.Phase~="Voting" and current=="Voting" then overlay.Visible=false current=nil end
        for id,b in voteButtons do if b.Parent then b.Text=tostring((round.Votes or {})[id] or 0).." Stimmen" end end
        if oldPhase~=round.Phase and round.Message and round.Message~="" then notify(round.Message) end
        if seconds&lt;=3 and seconds&gt;0 then Effects.Sound("Countdown") end
    elseif kind=="Notice" then notify(payload)
    elseif kind=="Open" then open(payload)
    elseif kind=="Owner" then
        if payload and not isOwner then local b=button(menu,"OWNER",function() open("Admin") end,palette.Pink) b.Size=UDim2.fromOffset(100,48) end isOwner=payload
    elseif kind=="Party" then party=payload if current=="Party" then render() end
    elseif kind=="PartyInvite" then invitation=payload notify(payload.Name.." lädt dich in eine Gruppe ein. Öffne PARTY.") if current=="Party" then render() end
    elseif kind=="Spin" then
        local wheel=body:FindFirstChild("Disc",true)
        if wheel then Tween:Create(wheel,TweenInfo.new(2,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{Rotation=wheel.Rotation+1440+math.random(0,359)}):Play() end
        task.delay(2,function() notify("GLÜCKSRAD: "..(if type(payload)=="number" then payload.." COINS" else Catalog.ById[payload].Name)) Effects.Sound("Victory") end)
    elseif kind=="Music" then musicActive=payload Effects.Music(payload)
    elseif kind=="Target" then Effects.Target(payload)
    elseif kind=="Color" then
        local colors={Color3.fromRGB(255,91,129),Color3.fromRGB(62,216,224),Color3.fromRGB(255,210,80),Color3.fromRGB(155,112,255),Color3.fromRGB(103,231,151),Color3.fromRGB(255,153,79)}
        toast.BackgroundColor3=colors[payload] toast.TextColor3=palette.Background
        task.delay(5,function() toast.BackgroundColor3=palette.Panel toast.TextColor3=palette.Text end)
    end
end)
remotes.Effect.OnClientEvent:Connect(Effects.Handle)
player:GetAttributeChangedSignal("SaveWarning"):Connect(function() if player:GetAttribute("SaveWarning") then notify("Speichern verzögert. Der Server versucht es erneut.") end end)
request:FireServer("Hello")
